{%- comment -%} Gut-skin pairing: two product cards and a bundle card. Prices come from the products. {%- endcomment -%}
{%- assign p1 = section.settings.product_1 -%}
{%- assign p2 = section.settings.product_2 -%}
{%- assign pb = section.settings.bundle_product -%}
<div class="wrapper sivp-pair">
  <div class="sivp-pair__head">
    {%- if section.settings.eyebrow != blank -%}<p class="sivp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2 sivp-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="sivp-body sivp-pair__text">{{ section.settings.text }}</div>{%- endif -%}
  </div>
  <div class="sivp-pair__grid" data-sivp-stagger>
    {%- for i in (1..2) -%}
      {%- if i == 1 -%}
        {%- assign p = p1 -%}{%- assign sub = section.settings.product_1_subtitle -%}
      {%- else -%}
        {%- assign p = p2 -%}{%- assign sub = section.settings.product_2_subtitle -%}
      {%- endif -%}
      {%- if p != blank -%}
        <a class="sivp-card" href="{{ p.url }}">
          <div class="sivp-card__media">
            {%- if p.featured_image -%}
              {%- assign p_alt = p.featured_image.alt | default: p.title -%}
              {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 30vw, 100vw', alt: p_alt }}
            {%- endif -%}
          </div>
          <div class="sivp-card__row">
            <span class="sivp-card__title">{{ p.title }}</span>
            <span class="sivp-card__price">{% if p.price_varies %}From {% endif %}{{ p.price_min | money }}</span>
          </div>
          {%- if sub != blank -%}<p class="sivp-card__sub">{{ sub }}</p>{%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
    {%- if pb != blank -%}
      <div class="sivp-bundle">
        <div>
          {%- if section.settings.bundle_eyebrow != blank -%}<p class="sivp-eyebrow">{{ section.settings.bundle_eyebrow }}</p>{%- endif -%}
          <h3 class="sivp-bundle__title">{{ section.settings.bundle_heading | default: pb.title }}</h3>
          {%- if section.settings.bundle_text != blank -%}<div class="sivp-body">{{ section.settings.bundle_text }}</div>{%- endif -%}
        </div>
        <div>
          <p class="sivp-bundle__price">{% if pb.price_varies %}From {% endif %}{{ pb.price_min | money }}</p>
          <a class="sivp-bundle__btn" href="{{ pb.url }}">{{ section.settings.bundle_button | default: 'Shop the bundle' }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .sivp-pair__text { max-width: 40rem; margin-top: 1rem; }
  .sivp-pair__grid { display: grid; gap: 2rem 1.5rem; margin-top: 2.5rem; }
  .sivp-card { display: block; color: inherit; text-decoration: none; }
  .sivp-card__media { aspect-ratio: 4 / 5; border-radius: 0.5rem; overflow: hidden; background: #e6e3dd; }
  .sivp-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .sivp-card:hover .sivp-card__media img { transform: scale(1.03); }
  .sivp-card__row { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; font-weight: 600; }
  .sivp-card__price { white-space: nowrap; }
  .sivp-card__sub { margin: 0.3rem 0 0; font-size: 0.875rem; color: rgba(var(--color-contrast), 0.65); }
  .sivp-bundle { background: #2f3427; color: #efefe9; --color-contrast: 239, 239, 233; border-radius: 0.5rem; padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .sivp-bundle__title { font-family: Gothic, sans-serif; text-transform: uppercase; font-size: clamp(2rem, 3vw, 2.75rem); line-height: 0.95; margin: 0 0 1rem; }
  .sivp-bundle__price { font-size: 1.25rem; margin: 0 0 1rem; }
  .sivp-bundle__btn { display: block; text-align: center; background: #efefe9; color: #121212; padding: 0.95rem 1rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.12s cubic-bezier(0.16, 1, 0.3, 1); }
  .sivp-bundle__btn:hover { background: #fff; }
  .sivp-bundle__btn:active { transform: scale(0.97); }
  @media (min-width: 768px) { .sivp-pair__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .sivp-card__media img { transition: none; } }
</style>

{% schema %}
{
  "name": "SIV pair and bundle",
  "tag": "section",
  "class": "siv-pdp-sec siv-pdp-pair",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The gut-skin axis" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Support your skin from the outside and within" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "text", "id": "product_1_subtitle", "label": "Product 1 subtitle" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "text", "id": "product_2_subtitle", "label": "Product 2 subtitle" },
    { "type": "product", "id": "bundle_product", "label": "Bundle product" },
    { "type": "text", "id": "bundle_eyebrow", "label": "Bundle eyebrow", "default": "Bundle" },
    { "type": "text", "id": "bundle_heading", "label": "Bundle heading" },
    { "type": "richtext", "id": "bundle_text", "label": "Bundle text" },
    { "type": "text", "id": "bundle_button", "label": "Bundle button label", "default": "Shop the bundle" }
  ],
  "presets": [{ "name": "SIV pair and bundle" }]
}
{% endschema %}
