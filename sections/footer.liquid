{% assign menu = linklists[section.settings.menu].links %}

<style>
  .siv-footer { padding-top: 3rem; padding-bottom: 2.5rem; display: grid; gap: 2.5rem 1.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .siv-footer__brand { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1rem; }
  .siv-footer__tagline { max-width: 12rem; }
  .siv-footer__social { display: flex; gap: 0.75rem; margin-top: 0.5rem; }
  .siv-footer__social a { display: inline-flex; width: 2.25rem; height: 2.25rem; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.3); border-radius: 999px; transition: border-color 0.2s cubic-bezier(0.16,1,0.3,1), transform 0.12s cubic-bezier(0.16,1,0.3,1); }
  .siv-footer__social a:hover { border-color: #fff; }
  .siv-footer__social a:active { transform: scale(0.93); }
  .siv-footer__social svg { width: 1rem; height: 1rem; }
  .siv-footer__col h3 { margin-bottom: 1rem; }
  .siv-footer__col li + li { margin-top: 0.5rem; }
  @media (min-width: 768px) {
    .siv-footer { grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr)); padding-top: 3.5rem; padding-bottom: 3rem; }
    .siv-footer__brand { grid-column: auto; }
  }
</style>

<div class="wrapper flex flex-col py-4">
  <div class="siv-footer border-y border-white/20">
    <div class="siv-footer__brand">
      {% render 'header-logo' %}
      <p class="siv-footer__tagline lead">The Biology of Resilience</p>
      {%- for link in menu -%}
        {%- assign link_handle = link.title | downcase | strip -%}
        {%- if link_handle == 'social' and link.links.size > 0 -%}
          <ul class="siv-footer__social" aria-label="{{ link.title }}">
            {%- for item in link.links -%}
              <li>
                <a href="{{ item.url }}" target="_blank" rel="noopener" aria-label="{{ item.title }}">
                  {%- assign item_handle = item.title | downcase -%}
                  {%- if item_handle contains 'instagram' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
                  {%- else -%}
                    <span class="text-xs">{{ item.title | slice: 0, 2 }}</span>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- for link in menu -%}
      {%- assign link_handle = link.title | downcase | strip -%}
      {%- if link_handle == 'social' -%}{%- continue -%}{%- endif -%}
      {%- if link.links.size > 0 -%}
        <div class="siv-footer__col">
          <h3 class="uppercase font-semibold font-body text-sm tracking-wide">{{ link.title }}</h3>
          <ul>
            {%- for item in link.links -%}
              <li><a href="{{ item.url }}" class="hover:opacity-50 duration-500">{{ item.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="flex flex-col sm:flex-row text-center sm:text-left justify-between pt-4 gap-2">
    <p class="text-sm opacity-50">
      &copy;{{ 'now' | date: '%Y' }} IRV Beauty, LLC
    </p>
    <p class="text-sm opacity-50">
      Site by
      <a
        href="https://wearestudiomelo.com"
        target="_blank"
        rel="noreferrer"
        class="hover:underline"
      >
        Studio Melo
      </a>
      &
      <a
        href="https://madebyverse.com"
        target="_blank"
        rel="noreferrer"
        class="hover:underline"
      >
        Verse
      </a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "bg-black text-white",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
