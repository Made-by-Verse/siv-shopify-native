{%- assign related_product = product.metafields.custom.related_product.value -%}
{%- assign related_product_blocks = section.blocks | where: 'type', 'related-product' -%}
<div class="wrapper grid gap-6 grid-cols-1 md:grid-cols-2">
  <div>
    <div data-product-gallery-container class="sticky top-32">
      {%- liquid
        assign selected_variant = product.selected_or_first_available_variant
        assign filtered_media_count = 0

        if product.variants.size > 1
          assign variant_title = selected_variant.title | handleize
        endif

        for media in product.media
          assign should_include = false

          if product.variants.size == 1
            assign should_include = true
          else
            if media.alt contains '_'
              assign split_alt = media.alt | split: ' '
              for word in split_alt
                if word contains '_'
                  assign split_word = word | split: '_'
                  assign image_variant = split_word.last | handleize
                  if variant_title == image_variant
                    assign should_include = true
                    break
                  endif
                endif
              endfor
            else
              assign should_include = true
            endif
          endif

          if should_include
            assign filtered_media_count = filtered_media_count | plus: 1
          endif
        endfor
      -%}
      {% if filtered_media_count > 1 %}
        {% render 'product-gallery', product: product %}
      {% elsif filtered_media_count == 1 %}
        {%- for media in product.media -%}
          {%- liquid
            assign should_include = false

            if product.variants.size == 1
              assign should_include = true
            else
              if media.alt contains '_'
                assign split_alt = media.alt | split: ' '
                for word in split_alt
                  if word contains '_'
                    assign split_word = word | split: '_'
                    assign image_variant = split_word.last | handleize
                    if variant_title == image_variant
                      assign should_include = true
                      break
                    endif
                  endif
                endfor
              else
                assign should_include = true
              endif
            endif
          -%}
          {%- if should_include -%}
            {% render 'responsive-image',
              image: media,
              wrapper_class: 'aspect-square bg-white',
              image_class: 'w-full h-full object-cover'
            %}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {% endif %}
    </div>
  </div>
  <div class="product-details">
    <div class="max-w-xl mx-auto">
      <form
        class="space-y-5"
        x-data="product"
        method="post"
        action="{{ routes.cart_add_url }}"
        @submit.prevent="$store.cart.addToCart($event, quantity)"
        id="product-form-{{ product.id }}"
        accept-charset="UTF-8"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          data-variant-id
        >

        {%- capture wholesale_breakdown_html -%}
          <style>
            .ws-pricing { margin-top: 2rem; padding: 1.75rem; border: 1px solid rgba(0,0,0,.1); border-radius: 1rem; background: rgba(255,255,255,.55); }
            .ws-pricing__head { padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(0,0,0,.1); }
            .ws-pricing--solo { max-width: 30rem; }
            .ws-pricing__head--solo { padding-bottom: 0; margin-bottom: 0; border-bottom: 0; }
            .ws-pricing__title { font-size: 1.75rem; line-height: 1.1; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; margin: 0; }
            .ws-pricing__note { font-size: .875rem; line-height: 1.5; color: rgba(0,0,0,.55); margin: .75rem 0 0; }
            .ws-pricing__head .ws-tier__rows { margin-top: 1rem; }
            .ws-pricing__grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem 2.5rem; }
            .ws-tier__size { font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .5rem; color: rgba(0,0,0,.55); }
            .ws-tier__rows { list-style: none; margin: 0; padding: 0; }
            .ws-tier__rows:empty { display: none; }
            .ws-tier__row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .625rem 0; border-top: 1px solid rgba(0,0,0,.08); font-size: .9375rem; }
            .ws-tier__row:first-child { border-top: 0; }
            .ws-tier__qty { color: rgba(0,0,0,.7); }
            .ws-tier__price { font-weight: 600; white-space: nowrap; }
            @media (max-width: 749px) {
              .ws-pricing { padding: 1.25rem; }
              .ws-pricing__grid { grid-template-columns: 1fr; gap: 1.5rem; }
            }
          </style>
          {%- assign ws_tier_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'wholesale-tier' -%}{%- assign ws_tier_count = ws_tier_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          <div class="ws-pricing{% if ws_tier_count == 0 %} ws-pricing--solo{% endif %}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'wholesale-pricing' -%}
                <div class="ws-pricing__head{% if ws_tier_count == 0 %} ws-pricing__head--solo{% endif %}" {{ block.shopify_attributes }}>
                  <h3 class="ws-pricing__title">{{ block.settings.heading }}</h3>
                  {%- if block.settings.intro != blank -%}
                    {% render 'ws-pricing-rows', text: block.settings.intro %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- if ws_tier_count > 0 -%}
              <div class="ws-pricing__grid">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'wholesale-tier' -%}
                    <div class="ws-tier" {{ block.shopify_attributes }}>
                      <h4 class="ws-tier__size">{{ block.settings.variant_heading }}</h4>
                      {% render 'ws-pricing-rows', text: block.settings.breakdown_text %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        {% assign wholesale_breakdown_rendered = false %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
            {% when 'product-title' %}
              {% render 'animated-heading', class: 'mb-2 h2', title: product.title %}
            {% when 'product-price' %}
              {% render 'price', product: product, use_variant: true, show_compare_at_price: true %}
            {% when 'product-description' %}
              <div class="my-8">
                <div
                  class="product-description relative"
                  :style="{ height: descriptionOpen ? $el.scrollHeight + 'px' : '90px' }"
                  :class="descriptionOpen && 'product-description-open'"
                >
                  {{ product.description }}
                </div>
                <button
                  class="underline font-semibold"
                  @click.prevent="descriptionOpen = !descriptionOpen"
                  x-text="descriptionOpen ? 'Read Less' : 'Read More'"
                ></button>
              </div>
            {% when 'accordion' %}
              {% if product.metafields.product.accordion %}
                {% render 'product-accordion', product: product %}
              {% endif %}
            {% when 'tag' %}
              {% if block.settings.liquid %}
                <div
                  class="inline-block py-2 px-3 bg-black/10 text-black rounded-full text-sm font-medium tracking-wide uppercase"
                  data-product-tag-container
                >
                  {{ block.settings.liquid }}
                </div>
              {% endif %}
            {% when 'buy-buttons' %}
              {% if product.is_sold_out %}
                <button class="btn btn--white">Sold out</button>
              {% else %}
                {% render 'buy-buttons',
                  product: product,
                  selectedVariant: product.selected_or_first_available_variant
                %}
              {% endif %}
            {% when 'related-product' %}
              {%- if related_product != blank -%}
                {% render 'related-product-card',
                  product: related_product,
                  drawer_id: 'related-product-drawer'
                %}
              {%- endif -%}
            {% when 'variant-picker' %}
              {% render 'variant-picker-pills', product: product, section: section %}
            {% when 'wholesale-volume-pricing' %}
              {% if product.quantity_price_breaks_configured? %}
                <div class="wholesale-volume-pricing">
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.description }}</p>
                </div>
              {% endif %}
            {% when 'wholesale-pricing' %}
              {% if wholesale_breakdown_rendered == false %}
                {% assign wholesale_breakdown_rendered = true %}
                {{ wholesale_breakdown_html }}
              {% endif %}
            {% when 'wholesale-tier' %}
              {% if wholesale_breakdown_rendered == false %}
                {% assign wholesale_breakdown_rendered = true %}
                {{ wholesale_breakdown_html }}
              {% endif %}
          {% endcase %}
        {% endfor %}
      </form>
    </div>
  </div>
</div>

{%- if related_product != blank and related_product_blocks.size > 0 -%}
  {% render 'quick-buy-drawer',
    product: related_product,
    drawer_id: 'related-product-drawer'
  %}
{%- endif -%}

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "templates": ["page", "collection", "list-collections", "index"],
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "product-title",
      "name": "Product Title",
      "limit": 1
    },
    {
      "type": "wholesale-volume-pricing",
      "name": "Wholesale Volume Pricing",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "wholesale-pricing",
      "name": "WS pricing breakdown",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "intro",
          "label": "Intro / description"
        }
      ]
    },
    {
      "type": "wholesale-tier",
      "name": "Variant tier",
      "settings": [
        {
          "type": "text",
          "id": "variant_heading",
          "label": "Variant heading"
        },
        {
          "type": "richtext",
          "id": "breakdown_text",
          "label": "Pricing breakdown"
        }
      ]
    },
    {
      "type": "product-price",
      "name": "Product Price",
      "limit": 1
    },
    {
      "type": "product-description",
      "name": "Product Description",
      "limit": 1
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 1
    },
    {
      "type": "buy-buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "variant-picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "related-product",
      "name": "Related Product",
      "limit": 1
    },
    {
      "type": "quantity-selector",
      "name": "Quantity Selector",
      "limit": 1
    },
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Liquid"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
