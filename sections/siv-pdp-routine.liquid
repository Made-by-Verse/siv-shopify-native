{%- comment -%} Routine: photo beside the step strip and how-to steps. {%- endcomment -%}
<div class="wrapper sivp-routine">
  <div class="sivp-routine__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 1024px) 45vw, 100vw', class: 'sivp-routine__img', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'sivp-routine__img' }}
    {%- endif -%}
  </div>
  <div class="sivp-routine__content">
    {%- if section.settings.eyebrow != blank -%}<p class="sivp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2 sivp-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="sivp-body sivp-routine__sub">{{ section.settings.subtext }}</p>{%- endif -%}
    <ol class="sivp-steps" aria-label="Routine order">
      {%- assign step_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'routine_step' -%}
          {%- assign step_i = step_i | plus: 1 -%}
          <li class="sivp-step{% if block.settings.highlight %} is-current{% endif %}" {{ block.shopify_attributes }}>
            <span class="sivp-step__num">{{ step_i | prepend: '0' | slice: -2, 2 }}</span>
            <span class="sivp-step__label">{{ block.settings.label }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
    <ol class="sivp-how">
      {%- assign how_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'how_step' -%}
          {%- assign how_i = how_i | plus: 1 -%}
          <li class="sivp-how__item" {{ block.shopify_attributes }}>
            <span class="sivp-how__num">{{ how_i }}</span>
            <div>
              <p class="sivp-how__title">{{ block.settings.title }}</p>
              <p class="sivp-body sivp-how__text">{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank -%}<div class="sivp-routine__note">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</div>

<style>
  .sivp-routine { display: grid; gap: 2.5rem; align-items: center; }
  .sivp-routine__media { border-radius: 0.75rem; overflow: hidden; aspect-ratio: 4 / 5; max-height: 34rem; background: #e6e3dd; }
  .sivp-routine__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sivp-routine__sub { margin-top: 1rem; }
  .sivp-steps { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .sivp-step { border: 1px solid rgba(var(--color-contrast), 0.15); border-radius: 0.375rem; padding: 0.75rem; min-height: 5.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .sivp-step.is-current { background: #dad6d0; border-color: rgba(var(--color-contrast), 0.4); }
  .sivp-step__num { font-size: 0.6875rem; letter-spacing: 0.2em; color: rgba(var(--color-contrast), 0.6); }
  .sivp-step__label { font-family: Gothic, sans-serif; text-transform: uppercase; font-size: 1.25rem; line-height: 1; }
  .sivp-step:not(.is-current) .sivp-step__label { color: rgba(var(--color-contrast), 0.7); }
  .sivp-how { list-style: none; margin: 1.75rem 0 0; padding: 0; border-top: 1px solid rgba(var(--color-contrast), 0.15); }
  .sivp-how__item { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.5rem; padding: 1.1rem 0; border-bottom: 1px solid rgba(var(--color-contrast), 0.15); }
  .sivp-how__num { font-family: Gothic, sans-serif; font-size: 2.25rem; line-height: 1; }
  .sivp-how__title { font-weight: 600; margin: 0 0 0.25rem; }
  .sivp-how__text { margin: 0; }
  .sivp-routine__note { margin-top: 1.25rem; font-size: 0.8125rem; line-height: 1.55; color: rgba(var(--color-contrast), 0.65); }
  @media (min-width: 768px) { .sivp-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .sivp-routine { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 4.5rem; align-items: center; } }
</style>

{% schema %}
{
  "name": "SIV routine",
  "tag": "section",
  "class": "siv-pdp-sec siv-pdp-routine",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your Biome Step™" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it part of your routine" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Add it right after cleansing or toning." },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "blocks": [
    {
      "type": "routine_step",
      "name": "Routine step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this step", "default": false }
      ]
    },
    {
      "type": "how_step",
      "name": "How-to step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "SIV routine" }]
}
{% endschema %}
