<div class="wrapper max-w-2xl py-16 md:py-32 text-center">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        {% render block %}
      {%- when 'heading' -%}
        <h2
          class="text-base font-body font-semibold uppercase tracking-wide mb-4"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.heading }}
        </h2>
      {%- when 'paragraph' -%}
        <p
          class="h2 opacity-100 mb-10"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.text }}
        </p>
      {%- when 'email_form' -%}
        <div class="max-w-xl mx-auto" {{ block.shopify_attributes }}>
          <iframe
            src="https://api.leadconnectorhq.com/widget/form/9zPBwCeHYvEs7hxla0ij"
            style="width:100%;min-height:442px;border:none;border-radius:8px"
            id="inline-9zPBwCeHYvEs7hxla0ij"
            data-layout="{'id':'INLINE'}"
            data-form-name="[SIV] Newsletter"
            data-height="442"
            data-layout-iframe-id="inline-9zPBwCeHYvEs7hxla0ij"
            data-form-id="9zPBwCeHYvEs7hxla0ij"
            title="[SIV] Newsletter">
          </iframe>
          <script src="https://link.msgsndr.com/js/form_embed.js" defer></script>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section--newsletter bg-black text-white",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Newsletter",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Subscribe to our newsletter to receive updates on new products and special offers.",
          "label": "Paragraph"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "Email Form",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
