{%- comment -%} What to expect: topics on the left, three captioned photos on the right. {%- endcomment -%}
<div class="wrapper sivp-expect">
  <div class="sivp-expect__text">
    {%- if section.settings.eyebrow != blank -%}<p class="sivp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2 sivp-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- for block in section.blocks -%}
      <div class="sivp-expect__topic" {{ block.shopify_attributes }}>
        <h3 class="sivp-expect__topic-title">{{ block.settings.title }}</h3>
        {%- if block.settings.lead != blank -%}<p class="sivp-expect__lead">{{ block.settings.lead }}</p>{%- endif -%}
        <div class="sivp-body">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
  <div class="sivp-expect__photos" data-sivp-stagger>
    {%- for i in (1..3) -%}
      {%- assign img_key = 'image_' | append: i -%}
      {%- assign cap_key = 'caption_' | append: i -%}
      {%- assign img = section.settings[img_key] -%}
      <figure class="sivp-expect__photo">
        <div class="sivp-expect__frame">
          {%- if img != blank -%}
            {{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 1024px) 16vw, 33vw', alt: img.alt }}
          {%- endif -%}
        </div>
        {%- if section.settings[cap_key] != blank -%}<figcaption>{{ section.settings[cap_key] }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</div>

<style>
  .siv-pdp-expect { background: #fff; }
  .sivp-expect { display: grid; gap: 3rem; align-items: center; }
  .sivp-expect__topic { margin-top: 2rem; }
  .sivp-expect__topic-title { font-family: inherit; text-transform: none; font-size: 1.25rem; line-height: 1.3; font-weight: 600; margin: 0 0 0.6rem; }
  .sivp-expect__lead { color: rgb(var(--color-contrast)); }
  .sivp-expect__lead { font-weight: 600; margin: 0 0 0.6rem; }
  .sivp-expect__photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .sivp-expect__photo { margin: 0; }
  .sivp-expect__frame { aspect-ratio: 3 / 4; background: #d8d4cc; overflow: hidden; }
  .sivp-expect__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sivp-expect__photo figcaption { margin-top: 0.75rem; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; }
  @media (min-width: 1024px) { .sivp-expect { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 4rem; } }
</style>

{% schema %}
{
  "name": "SIV what to expect",
  "tag": "section",
  "class": "siv-pdp-sec siv-pdp-sec--band siv-pdp-expect",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ask SIV" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect from your serum" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "text", "id": "caption_1", "label": "Photo 1 caption" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "text", "id": "caption_2", "label": "Photo 2 caption" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "text", "id": "caption_3", "label": "Photo 3 caption" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "lead", "label": "Bold first line" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "SIV what to expect" }]
}
{% endschema %}
