{%- comment -%} What to expect: topics on the left, one photo frame on the right that rotates through up to three photos. {%- endcomment -%}
<div class="wrapper sivp-expect">
  <div class="sivp-expect__text">
    {%- if section.settings.eyebrow != blank -%}<p class="sivp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2 sivp-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- for block in section.blocks -%}
      <div class="sivp-expect__topic" {{ block.shopify_attributes }}>
        <h3 class="sivp-expect__topic-title">{{ block.settings.title }}</h3>
        {%- if block.settings.lead != blank -%}<p class="sivp-expect__lead">{{ block.settings.lead }}</p>{%- endif -%}
        <div class="sivp-body">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
  <div class="sivp-expect__rotator" data-sivp-rotator>
    {%- assign shown = 0 -%}
    {%- for i in (1..3) -%}
      {%- assign img_key = 'image_' | append: i -%}
      {%- assign img = section.settings[img_key] -%}
      {%- if img != blank -%}
        <div class="sivp-expect__slide{% if shown == 0 %} is-active{% endif %}">
          {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 28rem, 80vw', alt: img.alt }}
        </div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .siv-pdp-expect { background: #fff; }
  .sivp-expect { display: grid; gap: 3rem; align-items: center; }
  .sivp-expect__topic { margin-top: 2rem; }
  .sivp-expect__topic-title { font-family: inherit; text-transform: none; font-size: 1.25rem; line-height: 1.3; font-weight: 600; margin: 0 0 0.6rem; }
  .sivp-expect__lead { color: rgb(var(--color-contrast)); font-weight: 600; margin: 0 0 0.6rem; }
  .sivp-expect__rotator { position: relative; width: 100%; max-width: 26rem; aspect-ratio: 1 / 1; margin: 0 auto; border-radius: 50%; overflow: hidden; }
  .sivp-expect__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .sivp-expect__slide.is-active { opacity: 1; }
  .sivp-expect__slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (min-width: 1024px) { .sivp-expect { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: 4.5rem; } }
</style>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var slides = root.querySelectorAll('.sivp-expect__slide');
    if (slides.length < 2) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var i = 0;
    setInterval(function () {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, 2600);
  })();
</script>

{% schema %}
{
  "name": "SIV what to expect",
  "tag": "section",
  "class": "siv-pdp-sec siv-pdp-sec--band siv-pdp-expect",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ask SIV" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect from your serum" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "text", "id": "caption_1", "label": "Photo 1 caption" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "text", "id": "caption_2", "label": "Photo 2 caption" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "text", "id": "caption_3", "label": "Photo 3 caption" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "lead", "label": "Bold first line" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "SIV what to expect" }]
}
{% endschema %}
