{% doc %}
  @prompt
    Create a CSS override for the product page trifolds template that stacks the layout vertically — placing the product title and description below the product photo. Scope it only to the trifolds view using a template-specific selector.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trifold-layout-override-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  body[data-view="trifolds"] .product-template,
  body[data-view="trifolds"] .product__content-wrapper,
  body[data-view="trifolds"] .product__media-wrapper,
  body[data-view="trifolds"] .product__info-wrapper {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  body[data-view="trifolds"] .product__media-wrapper {
    {% if block.settings.photo_position == 'top' %}
      order: 1 !important;
    {% else %}
      order: 2 !important;
    {% endif %}
    margin-bottom: {{ block.settings.spacing_below_photo }}px !important;
  }

  body[data-view="trifolds"] .product__info-wrapper {
    {% if block.settings.photo_position == 'top' %}
      order: 2 !important;
    {% else %}
      order: 1 !important;
    {% endif %}
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  body[data-view="trifolds"] .product__title {
    margin-bottom: {{ block.settings.title_spacing }}px !important;
  }

  body[data-view="trifolds"] .product__description {
    margin-top: {{ block.settings.description_spacing }}px !important;
  }

  {% if block.settings.center_content %}
    body[data-view="trifolds"] .product__info-wrapper,
    body[data-view="trifolds"] .product__title,
    body[data-view="trifolds"] .product__description {
      text-align: center !important;
    }
  {% endif %}

  {% if block.settings.max_content_width > 0 %}
    body[data-view="trifolds"] .product__info-wrapper {
      max-width: {{ block.settings.max_content_width }}px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
  {% endif %}

  body[data-view="trifolds"] .product__media-wrapper img {
    width: 100% !important;
    height: auto !important;
  }
{% endstyle %}

<div class="ai-trifold-layout-override-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <style>
    .ai-trifold-override-notice-{{ ai_gen_id }} {
      padding: 16px;
      background-color: {{ block.settings.notice_bg_color }};
      color: {{ block.settings.notice_text_color }};
      border-radius: 8px;
      text-align: center;
      font-size: 14px;
      margin: 20px 0;
    }
  </style>
  
  {% if block.settings.show_notice %}
    <div class="ai-trifold-override-notice-{{ ai_gen_id }}">
      {{ block.settings.notice_text }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Trifold layout override",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "paragraph",
      "content": "This block applies CSS overrides to stack the product photo above the title and description only when the trifolds view is active."
    },
    {
      "type": "select",
      "id": "photo_position",
      "label": "Photo position",
      "options": [
        {
          "value": "top",
          "label": "Above content"
        },
        {
          "value": "bottom",
          "label": "Below content"
        }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "center_content",
      "label": "Center align content",
      "default": false
    },
    {
      "type": "range",
      "id": "max_content_width",
      "label": "Max content width",
      "min": 0,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 0,
      "info": "Set to 0 for full width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_below_photo",
      "label": "Space below photo",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Space below title",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Space above description",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Notice"
    },
    {
      "type": "checkbox",
      "id": "show_notice",
      "label": "Show layout notice",
      "default": false,
      "info": "Display a notice on the page when this override is active"
    },
    {
      "type": "text",
      "id": "notice_text",
      "label": "Notice text",
      "default": "Trifold layout active"
    },
    {
      "type": "color",
      "id": "notice_bg_color",
      "label": "Notice background",
      "default": "#f6f5ed"
    },
    {
      "type": "color",
      "id": "notice_text_color",
      "label": "Notice text color",
      "default": "#241917"
    }
  ],
  "presets": [
    {
      "name": "Trifold layout override"
    }
  ]
}
{% endschema %}
