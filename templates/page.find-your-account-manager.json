us: 14px;\n\n      padding: 16px 18px;\n      margin: 22px 0;\n\n      transition: background .28s cubic-bezier(.22,.61,.36,1);\n    }\n\n    #siv-am .card .states strong {\n      color: var(--ink);\n      font-weight: 600;\n    }\n\n    #siv-am .card .cta-row {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      flex-wrap: wrap;\n    }\n\n    #siv-am .card .cta-row .btn {\n      width: auto;\n      flex: 0 0 auto;\n    }\n\n    #siv-am .card .email {\n      font-size: 14px;\n      color: var(--i500);\n      word-break: break-all;\n    }\n\n    #siv-am .card .email:hover {\n      color: var(--ink);\n    }\n\n\n    /* ================================\n       INTERNATIONAL\n    ================================= */\n\n    #siv-am .intl {\n      background: var(--i100);\n      border-top: 1px solid var(--hair);\n      margin-top: 0;\n    }\n\n    #siv-am .intl-in {\n      max-width: 1120px;\n      margin: 0 auto;\n      padding: 56px 44px;\n\n      display: flex;\n      gap: 40px;\n      align-items: center;\n      justify-content: space-between;\n      flex-wrap: wrap;\n    }\n\n    #siv-am .intl-txt {\n      flex: 1 1 460px;\n      min-width: 300px;\n    }\n\n    #siv-am .intl-txt .eyebrow {\n      margin-bottom: 16px;\n    }\n\n    #siv-am .intl-txt h2 {\n      font-family: var(--font-disp);\n      text-transform: uppercase;\n      font-weight: 500;\n\n      font-size: clamp(30px,4vw,46px);\n      line-height: .94;\n      letter-spacing: -.005em;\n\n      color: var(--ink);\n    }\n\n    #siv-am .intl-txt p {\n      font-size: 16px;\n      line-height: 1.55;\n      color: var(--i500);\n\n      margin-top: 16px;\n      max-width: 560px;\n    }\n\n    #siv-am .intl-cta {\n      flex: 0 0 auto;\n    }\n\n    #siv-am .intl-cta .btn {\n      width: auto;\n    }\n\n\n    /* ================================\n       ANIMATION\n    ================================= */\n\n    @keyframes sivMatchIn {\n      from {\n        opacity: 0;\n        transform: translateY(14px);\n      }\n\n      to {\n        opacity: 1;\n        transform: translateY(-6px);\n      }\n    }\n\n\n    /* ================================\n       TABLET\n    ================================= */\n\n    @media (max-width: 860px) {\n      #siv-am .cards {\n        grid-template-columns: 1fr;\n      }\n    }\n\n\n    /* ================================\n       MOBILE\n    ================================= */\n\n    @media (max-width: 760px) {\n\n      #siv-am .hero-in {\n        padding: 52px 20px 30px;\n      }\n\n      #siv-am .hero-sub {\n        font-size: 16px;\n      }\n\n      #siv-am .body {\n        padding-left: 20px;\n        padding-right: 20px;\n        padding-bottom: 52px;\n      }\n\n      #siv-am .matcher {\n        padding: 22px 20px;\n        gap: 18px;\n        margin-top: -24px;\n        text-align: center;\n      }\n\n      #siv-am .m-label {\n        text-align: center;\n      }\n\n      #siv-am .m-result {\n        min-width: 0;\n      }\n\n      #siv-am .card .card-in {\n        padding: 26px 22px 30px;\n        text-align: center;\n      }\n\n      #siv-am .card .badge {\n        align-self: center;\n      }\n\n      #siv-am .card .chead {\n        flex-direction: column;\n        align-items: center;\n        gap: 14px;\n      }\n\n      #siv-am .card .mono {\n        width: 56px;\n        height: 56px;\n        font-size: 23px;\n        border-radius: 15px;\n      }\n\n      #siv-am .card h3 {\n        font-size: 32px;\n        margin-top: 2px;\n      }\n\n      #siv-am .card .states {\n        text-align: center;\n      }\n\n      #siv-am .card .cta-row {\n        flex-direction: column;\n        align-items: stretch;\n        gap: 12px;\n      }\n\n      #siv-am .card .cta-row .btn {\n        width: 100%;\n      }\n\n      #siv-am .card .email {\n        text-align: center;\n      }\n\n      #siv-am .card.matched {\n        order: -1;\n        animation: sivMatchIn .34s cubic-bezier(.22,.61,.36,1);\n      }\n\n      #siv-am .intl-in {\n        padding: 44px 20px;\n        flex-direction: column;\n        align-items: center;\n        text-align: center;\n        gap: 26px;\n      }\n\n      #siv-am .intl-txt {\n        flex: 1 1 auto;\n        min-width: 0;\n      }\n\n      #siv-am .intl-txt p {\n        margin-left: auto;\n        margin-right: auto;\n      }\n\n      #siv-am .intl-cta {\n        width: 100%;\n      }\n\n      #siv-am .intl-cta .btn {\n        width: 100%;\n      }\n    }\n\n  </style>\n\n\n  <!-- ================================\n       HERO\n  ================================= -->\n\n  <section class=\"hero\">\n    <div class=\"hero-in\">\n\n      <p class=\"eyebrow\">\n        SIV Wholesale Partners\n      </p>\n\n      <h1 class=\"hero-h1\">\n        Find your<br>account manager\n      </h1>\n\n      <p class=\"hero-sub\">\n        Every SIV wholesale partner gets a dedicated Account Manager\n        who knows your market. Find your region below to meet yours.\n        They're your go-to for orders, restocks, launches, and\n        everything in between.\n      </p>\n\n    </div>\n  </section>\n\n\n  <!-- ================================\n       STATE SELECTOR + CARDS\n  ================================= -->\n\n  <div class=\"body\">\n\n    <div class=\"matcher\">\n\n      <div class=\"fld\">\n\n        <label class=\"m-label\" for=\"siv-state\">\n          Where is your account based?\n        </label>\n\n        <select class=\"m-select\" id=\"siv-state\">\n          <option value=\"\">\n            Select your state…\n          </option>\n        </select>\n\n      </div>\n\n\n      <div class=\"m-result\" id=\"siv-result\">\n\n        <div class=\"lead\" id=\"siv-result-lead\">\n        </div>\n\n        <div class=\"rname\" id=\"siv-result-name\">\n        </div>\n\n        <div class=\"rmeta\" id=\"siv-result-meta\">\n        </div>\n\n      </div>\n\n    </div>\n\n\n    <div class=\"cards\">\n\n\n      <!-- ============================\n           ALLI AYERS\n      ============================= -->\n\n      <div class=\"card\" id=\"card-alli\" style=\"--acc:#121212\">\n\n        <div class=\"accent-bar\"></div>\n\n        <div class=\"card-in\">\n\n          <span class=\"badge\">\n            Your manager\n          </span>\n\n          <div class=\"chead\">\n\n            <div class=\"mono\">\n              AA\n            </div>\n\n            <div>\n\n              <div class=\"region\">\n                West Coast Region\n              </div>\n\n              <h3>\n                Alli Ayers\n              </h3>\n\n              <p class=\"role\">\n                Account Manager\n              </p>\n\n            </div>\n\n          </div>\n\n\n          <p class=\"states\">\n            <strong>West Coast:</strong>\n            AZ, CA, NV.\n          </p>\n\n\n          <div class=\"cta-row\">\n\n            <a class=\"btn btn-ink\" href=\"mailto:aayers@sivcare.com\">\n              Email Alli\n            </a>\n\n            <a class=\"email\" href=\"mailto:aayers@sivcare.com\">\n              aayers@sivcare.com\n            </a>\n\n          </div>\n\n        </div>\n\n      </div>\n\n\n      <!-- ============================\n           ISABEL VITALE\n      ============================= -->\n\n      <div class=\"card\" id=\"card-isabel\" style=\"--acc:#121212\">\n\n        <div class=\"accent-bar\"></div>\n\n        <div class=\"card-in\">\n\n          <span class=\"badge\">\n            Your manager\n          </span>\n\n          <div class=\"chead\">\n\n            <div class=\"mono\">\n              IV\n            </div>\n\n            <div>\n\n              <div class=\"region\">\n                All Other U.S. Regions\n              </div>\n\n              <h3>\n                Isabel Vitale\n              </h3>\n\n              <p class=\"role\">\n                Account Manager\n              </p>\n\n            </div>\n\n          </div>\n\n\n          <p class=\"states\">\n            <strong>All Other U.S. Regions:</strong>\n            All U.S. states outside of AZ, CA, and NV, including DC.\n          </p>\n\n\n          <div class=\"cta-row\">\n\n            <a class=\"btn btn-ink\" href=\"mailto:isabel@sivcare.com\">\n              Email Isabel\n            </a>\n\n            <a class=\"email\" href=\"mailto:isabel@sivcare.com\">\n              isabel@sivcare.com\n            </a>\n\n          </div>\n\n        </div>\n\n      </div>\n\n\n    </div>\n  </div>\n\n\n  <!-- ================================\n       INTERNATIONAL\n  ================================= -->\n\n  <section class=\"intl\">\n\n    <div class=\"intl-in\">\n\n      <div class=\"intl-txt\">\n\n        <p class=\"eyebrow\">\n          International &amp; General Inquiries\n        </p>\n\n        <h2>\n          Partnering from<br>outside the U.S.?\n        </h2>\n\n        <p>\n          For partners in international markets, our wholesale team\n          is your first point of contact. We'll ensure you're connected\n          with the right resources to support your business.\n        </p>\n\n      </div>\n\n\n      <div class=\"intl-cta\">\n\n        <a class=\"btn btn-out\" href=\"mailto:info@sivcare.com\">\n          info@sivcare.com\n        </a>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n  <!-- ================================\n       STATE MATCHING LOGIC\n  ================================= -->\n\n  <script>\n\n    (function () {\n\n      /*\n       * REP ASSIGNMENTS\n       *\n       * Alli:\n       * AZ, CA, NV\n       *\n       * Isabel:\n       * Every other U.S. state + DC\n       */\n\n      var ALLI = \"alli\";\n      var ISABEL = \"isabel\";\n\n\n      var STATES = [\n\n        [\"AL\",\"Alabama\",ISABEL],\n        [\"AK\",\"Alaska\",ISABEL],\n        [\"AZ\",\"Arizona\",ALLI],\n        [\"AR\",\"Arkansas\",ISABEL],\n\n        [\"CA\",\"California\",ALLI],\n        [\"CO\",\"Colorado\",ISABEL],\n        [\"CT\",\"Connecticut\",ISABEL],\n        [\"DE\",\"Delaware\",ISABEL],\n\n        [\"DC\",\"District of Columbia\",ISABEL],\n\n        [\"FL\",\"Florida\",ISABEL],\n        [\"GA\",\"Georgia\",ISABEL],\n        [\"HI\",\"Hawaii\",ISABEL],\n\n        [\"ID\",\"Idaho\",ISABEL],\n        [\"IL\",\"Illinois\",ISABEL],\n        [\"IN\",\"Indiana\",ISABEL],\n        [\"IA\",\"Iowa\",ISABEL],\n\n        [\"KS\",\"Kansas\",ISABEL],\n        [\"KY\",\"Kentucky\",ISABEL],\n\n        [\"LA\",\"Louisiana\",ISABEL],\n\n        [\"ME\",\"Maine\",ISABEL],\n        [\"MD\",\"Maryland\",ISABEL],\n        [\"MA\",\"Massachusetts\",ISABEL],\n        [\"MI\",\"Michigan\",ISABEL],\n        [\"MN\",\"Minnesota\",ISABEL],\n        [\"MS\",\"Mississippi\",ISABEL],\n        [\"MO\",\"Missouri\",ISABEL],\n        [\"MT\",\"Montana\",ISABEL],\n\n        [\"NE\",\"Nebraska\",ISABEL],\n        [\"NV\",\"Nevada\",ALLI],\n        [\"NH\",\"New Hampshire\",ISABEL],\n        [\"NJ\",\"New Jersey\",ISABEL],\n        [\"NM\",\"New Mexico\",ISABEL],\n        [\"NY\",\"New York\",ISABEL],\n        [\"NC\",\"North Carolina\",ISABEL],\n        [\"ND\",\"North Dakota\",ISABEL],\n\n        [\"OH\",\"Ohio\",ISABEL],\n        [\"OK\",\"Oklahoma\",ISABEL],\n        [\"OR\",\"Oregon\",ISABEL],\n\n        [\"PA\",\"Pennsylvania\",ISABEL],\n\n        [\"RI\",\"Rhode Island\",ISABEL],\n\n        [\"SC\",\"South Carolina\",ISABEL],\n        [\"SD\",\"South Dakota\",ISABEL],\n\n        [\"TN\",\"Tennessee\",ISABEL],\n        [\"TX\",\"Texas\",ISABEL],\n\n        [\"UT\",\"Utah\",ISABEL],\n\n        [\"VT\",\"Vermont\",ISABEL],\n        [\"VA\",\"Virginia\",ISABEL],\n\n        [\"WA\",\"Washington\",ISABEL],\n        [\"WV\",\"West Virginia\",ISABEL],\n        [\"WI\",\"Wisconsin\",ISABEL],\n        [\"WY\",\"Wyoming\",ISABEL]\n\n      ];\n\n\n      var MGR = {\n\n        alli: {\n          name: \"Alli Ayers\",\n          region: \"West Coast Region\",\n          email: \"aayers@sivcare.com\",\n          card: \"card-alli\"\n        },\n\n        isabel: {\n          name: \"Isabel Vitale\",\n          region: \"All Other U.S. Regions\",\n          email: \"isabel@sivcare.com\",\n          card: \"card-isabel\"\n        }\n\n      };\n\n\n      var root =\n        document.getElementById(\"siv-am\");\n\n      var sel =\n        root.querySelector(\"#siv-state\");\n\n\n      /*\n       * Build state dropdown\n       */\n\n      STATES\n        .slice()\n        .sort(function (a, b) {\n\n          return a[1] < b[1]\n            ? -1\n            : 1;\n\n        })\n        .forEach(function (s) {\n\n          var o =\n            document.createElement(\"option\");\n\n          o.value =\n            s[0];\n\n          o.textContent =\n            s[1];\n\n          sel.appendChild(o);\n\n        });\n\n\n      var result =\n        root.querySelector(\"#siv-result\");\n\n      var lead =\n        root.querySelector(\"#siv-result-lead\");\n\n      var name =\n        root.querySelector(\"#siv-result-name\");\n\n      var meta =\n        root.querySelector(\"#siv-result-meta\");\n\n      var cards =\n        root.querySelectorAll(\".card\");\n\n\n      /*\n       * Match selected state\n       * to Alli or Isabel\n       */\n\n      sel.addEventListener(\n        \"change\",\n        function () {\n\n          var row =\n            STATES.filter(function (s) {\n\n              return s[0] === sel.value;\n\n            })[0];\n\n\n          cards.forEach(function (c) {\n\n            c.classList.remove(\"matched\");\n\n          });\n\n\n          if (!row) {\n\n            result.style.display =\n              \"none\";\n\n            return;\n\n          }\n\n\n          var m =\n            MGR[row[2]];\n\n\n          lead.textContent =\n            \"Partners in \" +\n            row[1] +\n            \" are supported by\";\n\n\n          name.textContent =\n            m.name;\n\n\n          meta.innerHTML =\n            m.region +\n            ' · <a href=\"mailto:' +\n            m.email +\n            '\" style=\"color:var(--pebble);text-decoration:underline\">' +\n            m.email +\n            '</a>';\n\n\n          result.style.display =\n            \"block\";\n\n\n          var el =\n            document.getElementById(\n              m.card\n            );\n\n\n          if (el) {\n\n            el.classList.add(\n              \"matched\"\n            );\n\n          }\n\n        }\n      );\n\n\n      /*\n       * FULL BLEED\n       *\n       * Pull the section to the\n       * viewport edges regardless\n       * of Shopify theme container.\n       */\n\n      function fullBleed() {\n\n        root.style.marginLeft =\n          \"0\";\n\n        root.style.marginRight =\n          \"0\";\n\n        root.style.width =\n          \"\";\n\n        root.style.maxWidth =\n          \"none\";\n\n\n        var vw =\n          document.documentElement.clientWidth;\n\n\n        var left =\n          root.getBoundingClientRect().left;\n\n\n        root.style.width =\n          vw + \"px\";\n\n\n        root.style.marginLeft =\n          (-left) + \"px\";\n\n      }\n\n\n      fullBleed();\n\n      window.addEventListener(\n        \"load\",\n        fullBleed\n      );\n\n      window.addEventListener(\n        \"resize\",\n        fullBleed\n      );\n\n    })();\n\n  </script>\n\n</div>",
