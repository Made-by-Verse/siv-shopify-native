        "ai_gen_block_183bc97_GXRaiQ": {
          "type": "ai_gen_block_183bc97",
          "settings": {
            "custom_html": "<!-- SIV - \"What to expect from your serum\" section (clumping + scent + how to use).\n     Paste this entire block into the Custom HTML block on the product page, replacing the old code.\n     Fonts: the theme's own Gothic (headings, weight 400) and Matter (body). Nothing is loaded here.\n     Images: hardcoded Shopify CDN URLs. -->\n\n<style>\n.siv-clump{\n  --ink:#121212; --cream:#efefe9; --ground:#e6e3dd; --stone:#a8a39c; --espresso:#544541; --taupe:#94857B; --pebble:#d7d2cb;\n  --line:rgba(18,18,18,.16);\n  --ease:cubic-bezier(.22,.61,.36,1);\n  --head:Gothic,sans-serif;\n  --body:Matter,sans-serif;\n  --pad:clamp(20px,6vw,120px);\n  position:relative; width:100vw; max-width:none; margin-left:calc(50% - 50vw); margin-right:0;\n  box-sizing:border-box; background:var(--cream); color:var(--ink);\n  font-family:var(--body); -webkit-font-smoothing:antialiased; overflow:hidden;\n}\n.siv-clump *,.siv-clump *::before,.siv-clump *::after{box-sizing:border-box;}\n.siv-clump p{margin:0;}\n.siv-clump strong{font-weight:600;}\n.siv-clump h1,.siv-clump h2,.siv-clump h3{margin:0;font-family:var(--head);font-weight:400;text-transform:uppercase;letter-spacing:0;line-height:1;color:inherit;}\n.siv-clump img{display:block;max-width:100%;}\n\n.siv-clump__wrap{max-width:1760px;margin:0 auto;padding-left:var(--pad);padding-right:var(--pad);}\n.siv-clump__label{font-weight:600;font-size:13px;letter-spacing:.22em;text-transform:uppercase;}\n.siv-clump__cap{font-weight:600;font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--espresso);}\n.siv-clump__p{font-size:clamp(16px,1.35vw,19px);line-height:1.65;text-wrap:pretty;}\n\n/* intro band */\n.siv-clump__band{background:#dad8d3;}\n.siv-clump__intro{padding-top:clamp(64px,7vw,108px);padding-bottom:clamp(64px,7vw,108px);display:flex;flex-direction:column;align-items:center;text-align:center;}\n.siv-clump__eyebrow{color:var(--espresso);}\n.siv-clump__h1{margin-top:18px !important;font-size:clamp(3.2rem,8vw,6rem);line-height:1;text-wrap:balance;}\n.siv-clump__lede{margin-top:clamp(20px,2.5vw,28px) !important;max-width:720px;font-size:clamp(17px,1.5vw,20px);line-height:1.65;color:var(--espresso);text-wrap:balance;}\n.siv-clump__pills{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:clamp(28px,3vw,40px);}\n.siv-clump__pill{display:inline-flex;align-items:center;height:52px;padding:0 30px;border:1px solid var(--ink);border-radius:999px;\n  font-family:var(--body);font-weight:600;font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink);text-decoration:none;\n  background:transparent;transition:background 280ms var(--ease),color 280ms var(--ease);}\n.siv-clump__pill:hover{background:var(--ink);color:var(--cream);text-decoration:none;}\n.siv-clump__band + .siv-clump__chapter{padding-top:clamp(64px,7vw,104px);}\n\n/* chapters */\n.siv-clump__chapter{padding-bottom:clamp(72px,8vw,120px);}\n.siv-clump__head{display:flex;align-items:center;gap:18px;padding-top:28px;border-top:1px solid var(--line);color:var(--espresso);}\n.siv-clump__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(48px,7vw,112px);align-items:center;margin-top:clamp(28px,3vw,40px);}\n.siv-clump__col{display:flex;flex-direction:column;gap:22px;max-width:580px;}\n.siv-clump__h2{font-size:clamp(2.4rem,5.6vw,4rem);line-height:1;text-wrap:balance;}\n.siv-clump__h3{font-size:clamp(1.6rem,2.6vw,2.25rem);line-height:1.05;}\n\n/* floating visual */\n.siv-clump__visual{position:relative;}\n.siv-clump__frame{position:relative;width:100%;aspect-ratio:5/4;background:var(--ground);overflow:hidden;}\n.siv-clump__slide{position:absolute;inset:0;opacity:0;transition:opacity 1000ms var(--ease);}\n.siv-clump__slide.is-on{opacity:1;}\n.siv-clump__plate{position:absolute;left:50%;top:44%;width:56%;aspect-ratio:1/1;border-radius:50%;overflow:hidden;\n  transform:translate(-50%,-50%) scale(.96);transition:transform 1600ms var(--ease);}\n.siv-clump__plate img{position:absolute;left:50%;top:50%;width:112%;height:112%;max-width:none;object-fit:cover;transform:translate(-50%,-50%);}\n.siv-clump__slide.is-on .siv-clump__plate{transform:translate(-50%,-50%) scale(1);}\n.siv-clump__vcap{position:absolute;top:22px;right:24px;left:24px;text-align:right;}\n.siv-clump__card{position:relative;margin:-64px 0 0 -24px;width:min(340px,70%);background:var(--ink);color:var(--cream);\n  padding:24px 26px 22px;display:flex;flex-direction:column;gap:14px;}\n.siv-clump__card-num{font-weight:600;font-size:12px;letter-spacing:.22em;color:var(--stone);}\n.siv-clump__card-title{display:grid;}\n.siv-clump__card-title span{grid-area:1/1;font-family:var(--head);font-weight:400;font-size:clamp(26px,2.4vw,32px);line-height:1;text-transform:uppercase;\n  opacity:0;transform:translateY(8px);transition:opacity 600ms var(--ease),transform 600ms var(--ease);}\n.siv-clump__card-title span.is-on{opacity:1;transform:none;}\n.siv-clump__segs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:4px;}\n.siv-clump__seg{position:relative;height:2px;background:rgba(239,239,233,.22);overflow:hidden;border:0;padding:0;cursor:pointer;}\n.siv-clump__seg::before{content:\"\";position:absolute;left:0;right:0;top:-10px;bottom:-10px;}\n.siv-clump__seg::after{content:\"\";position:absolute;inset:0;background:var(--cream);transform:scaleX(0);transform-origin:left;}\n.siv-clump__seg.is-on::after{transform:scaleX(1);transition:transform var(--dwell,2800ms) linear;}\n.siv-clump__seg.is-done::after{transform:scaleX(1);}\n\n/* scent bar */\n.siv-clump__scent{margin-top:clamp(48px,5vw,72px);}\n.siv-clump__track{position:relative;margin-top:16px;height:14px;border-radius:7px;background:var(--pebble);overflow:visible;}\n.siv-clump__fill{position:absolute;inset:0;border-radius:7px;background:linear-gradient(90deg,#4f5845 0%,#727d64 40%,#a9b09c 75%,#e6e3dd 100%);\n  transform-origin:left center;}\n.siv-clump__dot{position:absolute;top:50%;left:0;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:var(--cream);\n  border:2px solid var(--ink);transition:left 1400ms var(--ease);}\n.siv-clump__stops{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:22px;}\n.siv-clump__stop{font-size:clamp(15px,1.3vw,18px);line-height:1.45;color:var(--espresso);cursor:pointer;transition:color 500ms var(--ease);}\n.siv-clump__stop:nth-child(2){text-align:center;}\n.siv-clump__stop:nth-child(3){text-align:right;}\n.siv-clump__stop.is-on{color:var(--ink);font-weight:600;}\n\n/* motion */\n.siv-clump.is-anim [data-reveal]{opacity:0;transform:translateY(22px);transition:opacity 800ms var(--ease),transform 800ms var(--ease);}\n.siv-clump.is-anim [data-reveal].is-in{opacity:1;transform:none;}\n.siv-clump.is-anim .siv-clump__card{opacity:0;transform:translateX(-16px);transition:opacity 800ms var(--ease) 350ms,transform 800ms var(--ease) 350ms;}\n.siv-clump.is-anim .is-in .siv-clump__card{opacity:1;transform:none;}\n.siv-clump.is-anim .siv-clump__fill{transform:scaleX(0);transition:transform 1600ms var(--ease) 200ms;}\n.siv-clump.is-anim .is-in .siv-clump__fill{transform:scaleX(1);}\n\n@media (max-width:1023px){\n  .siv-clump__grid{grid-template-columns:minmax(0,1fr);gap:40px;}\n  .siv-clump__col{max-width:none;}\n  .siv-clump__frame{max-height:none;}\n  .siv-clump__card{margin-left:16px;}\n}\n@media (max-width:599px){\n  .siv-clump__intro{padding-top:56px;padding-bottom:56px;}\n  .siv-clump__lede{text-wrap:pretty;}\n  .siv-clump__pills{gap:10px;}\n  .siv-clump__band + .siv-clump__chapter{padding-top:48px;}\n  .siv-clump__chapter{padding-bottom:64px;}\n  .siv-clump__head{padding-top:20px;}\n  .siv-clump__grid{margin-top:20px;gap:32px;}\n  .siv-clump__col{gap:18px;}\n  .siv-clump__vcap{top:14px;right:16px;left:16px;font-size:10px;}\n  .siv-clump__card{padding:20px 20px 18px;gap:12px;}\n  .siv-clump__track{height:12px;}\n  .siv-clump__dot{width:22px;height:22px;margin:-11px 0 0 -11px;}\n  .siv-clump__stop{font-size:15px;padding-left:14px;border-left:2px solid transparent;transition:color 500ms var(--ease),border-color 500ms var(--ease);}\n  .siv-clump__stop br{display:none;}\n  .siv-clump__stop.is-on{border-left-color:#727d64;}\n  .siv-clump__frame{aspect-ratio:1/1;}\n  .siv-clump__plate{width:66%;top:46%;}\n  .siv-clump__card{margin:-40px 16px 0;width:auto;}\n  .siv-clump__vcap{top:16px;right:16px;}\n  .siv-clump__stops{grid-template-columns:minmax(0,1fr);gap:10px;}\n  .siv-clump__stop:nth-child(2),.siv-clump__stop:nth-child(3){text-align:left;}\n  .siv-clump__pill{height:46px;padding:0 22px;font-size:12px;}\n}\n@media (prefers-reduced-motion:reduce){\n  .siv-clump *{transition:none !important;}\n  .siv-clump [data-reveal],.siv-clump .siv-clump__card{opacity:1 !important;transform:none !important;}\n  .siv-clump .siv-clump__fill{transform:none !important;}\n}\n</style>\n\n<section class=\"siv-clump\" data-siv-clump=\"\" aria-label=\"What to expect from your serum\">\n\n  <div class=\"siv-clump__band\">\n    <div class=\"siv-clump__wrap siv-clump__intro\">\n      <div class=\"siv-clump__eyebrow siv-clump__label\" data-reveal=\"\">Ask SIV</div>\n      <h1 class=\"siv-clump__h1\" data-reveal=\"\">What to expect from your serum</h1>\n      <p class=\"siv-clump__lede\" data-reveal=\"\">Our serum is made without fillers, suspension agents, or added fragrance, so it may look and smell a little different from other skincare you have used. Here is a quick guide to what you’ll notice.</p>\n      <nav class=\"siv-clump__pills\" data-reveal=\"\" aria-label=\"Jump to\">\n        <a class=\"siv-clump__pill\" href=\"#siv-clumping\" data-jump=\"\">Clumping</a>\n        <a class=\"siv-clump__pill\" href=\"#siv-scent\" data-jump=\"\">Scent</a>\n      </nav>\n    </div>\n  </div>\n\n  <div class=\"siv-clump__wrap siv-clump__chapter\" id=\"siv-clumping\">\n    <div class=\"siv-clump__head\" data-reveal=\"\"><span class=\"siv-clump__label\">01</span></div>\n    <div class=\"siv-clump__grid\">\n      <div class=\"siv-clump__col\">\n        <h2 class=\"siv-clump__h2\" data-reveal=\"\">Is clumping expected?</h2>\n        <div class=\"siv-clump__col\" data-reveal=\"\">\n          <h3 class=\"siv-clump__h3\">Yes, and the particles won’t fully disappear.</h3>\n          <p class=\"siv-clump__p\">Nothing in the bottle is there to hold the particles (the Bacillus spores) in place or make them invisible, so natural settling and <strong>clumping are part of how it looks.</strong></p>\n          <p class=\"siv-clump__p\">Shaking lifts the particles and spreads them through the liquid. <strong>It does not dissolve them.</strong> You will still see them after shaking, in a range of sizes, and that is exactly what you should see. They melt into the skin on application.</p>\n        </div>\n      </div>\n\n      <div class=\"siv-clump__visual\" data-reveal=\"\" data-cycler=\"\">\n        <div class=\"siv-clump__frame\">\n          <div class=\"siv-clump__slide is-on\"><div class=\"siv-clump__plate\"><img src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/siv-dropper-1.png?v=1786920455\" alt=\"Bottom of the dropper showing visible clumps after shipping\" loading=\"lazy\" width=\"1200\" height=\"1200\"></div></div>\n          <div class=\"siv-clump__slide\"><div class=\"siv-clump__plate\"><img src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/siv-dropper-2.png?v=1786920456\" alt=\"Bottom of the dropper showing particles beginning to disperse\" loading=\"lazy\" width=\"1200\" height=\"1200\"></div></div>\n          <div class=\"siv-clump__slide\"><div class=\"siv-clump__plate\"><img src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/siv-dropper-3.png?v=1786920457\" alt=\"Bottom of the dropper showing suspended particles of varying sizes\" loading=\"lazy\" width=\"1200\" height=\"1200\"></div></div>\n          <div class=\"siv-clump__vcap siv-clump__cap\">(Pictured bottom of dropper)</div>\n        </div>\n        <div class=\"siv-clump__card\">\n          <div class=\"siv-clump__card-num\" data-num=\"\">01 / 03</div>\n          <div class=\"siv-clump__card-title\" aria-live=\"polite\">\n            <span class=\"is-on\">Visible clumps after shipping</span>\n            <span>Particles begin to disperse</span>\n            <span>Suspended particles, sizes will vary</span>\n          </div>\n          <div class=\"siv-clump__segs\">\n            <button class=\"siv-clump__seg is-on\" type=\"button\" aria-label=\"Visible clumps after shipping\"></button>\n            <button class=\"siv-clump__seg\" type=\"button\" aria-label=\"Particles begin to disperse\"></button>\n            <button class=\"siv-clump__seg\" type=\"button\" aria-label=\"Suspended particles, sizes will vary\"></button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"siv-clump__wrap siv-clump__chapter\" id=\"siv-scent\">\n    <div class=\"siv-clump__head\" data-reveal=\"\"><span class=\"siv-clump__label\">02</span></div>\n    <div class=\"siv-clump__grid\">\n      <h2 class=\"siv-clump__h2\" data-reveal=\"\" style=\"align-self:start;\">Where does the scent come from?</h2>\n      <div class=\"siv-clump__col\" data-reveal=\"\" style=\"align-self:start;\">\n        <h3 class=\"siv-clump__h3\">It’s the natural scent of our ingredients, and it fades quickly.</h3>\n        <p class=\"siv-clump__p\">Our serum does not contain any added fragrance. The compounds used in added fragrances can compromise the skin microbiome, so <strong>we leave them out of the formula completely.</strong></p>\n        <p class=\"siv-clump__p\">The scent you notice comes from the biocompatible ingredients themselves. It is unique to our serum and <strong>part of what makes it our formula.</strong></p>\n        <p class=\"siv-clump__p\">The scent dissipates quickly after application, so it will not linger on your skin through the day.</p>\n      </div>\n    </div>\n\n    <div class=\"siv-clump__scent\" data-reveal=\"\" data-scent=\"\">\n      <div class=\"siv-clump__cap\">(Scent from bottle to skin)</div>\n      <div class=\"siv-clump__track\" aria-hidden=\"true\">\n        <div class=\"siv-clump__fill\"></div>\n        <div class=\"siv-clump__dot\"></div>\n      </div>\n      <div class=\"siv-clump__stops\">\n        <div class=\"siv-clump__stop is-on\">Most noticeable when you first open the bottle</div>\n        <div class=\"siv-clump__stop\">Softens as you apply</div>\n        <div class=\"siv-clump__stop\">Dissipates quickly<br>after application</div>\n      </div>\n    </div>\n  </div>\n\n</section>\n\n<script>\n(function(){\n  var DWELL = 2800;\n  var roots = document.querySelectorAll('[data-siv-clump]');\n  Array.prototype.forEach.call(roots, function(root){\n    if (root.dataset.sivInit) return;\n    root.dataset.sivInit = '1';\n\n    // full-bleed: pin the section to the viewport edges even inside off-center theme columns\n    function bleed(){\n      var vw = document.documentElement.clientWidth;\n      root.style.marginLeft = '0px';\n      root.style.width = vw + 'px';\n      var left = root.getBoundingClientRect().left;\n      root.style.marginLeft = (-left) + 'px';\n    }\n    bleed();\n    window.addEventListener('resize', bleed);\n    window.addEventListener('load', bleed);\n\n    // headings: copy the exact face the theme gives the main title onto every sub-heading\n    function matchHeads(){\n      var h1 = root.querySelector('.siv-clump__h1');\n      if (!h1) return;\n      var cs = getComputedStyle(h1);\n      Array.prototype.forEach.call(root.querySelectorAll('h2,h3,.siv-clump__card-title span'), function(el){\n        el.style.fontFamily = cs.fontFamily;\n        el.style.fontWeight = cs.fontWeight;\n        el.style.fontStretch = cs.fontStretch;\n        el.style.letterSpacing = cs.letterSpacing;\n        el.style.fontStyle = cs.fontStyle;\n      });\n    }\n    matchHeads();\n    window.addEventListener('load', matchHeads);\n    if (document.fonts && document.fonts.ready) document.fonts.ready.then(matchHeads);\n    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var hasIO = 'IntersectionObserver' in window;\n    var each = function(list, fn){ Array.prototype.forEach.call(list, fn); };\n\n    var items = root.querySelectorAll('[data-reveal]');\n    function showAll(){ each(items, function(el){ el.classList.add('is-in'); }); }\n    if (!reduce && hasIO) {\n      root.classList.add('is-anim');\n      var io = new IntersectionObserver(function(entries){\n        entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });\n      }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });\n      each(items, function(el){\n        var sibs = Array.prototype.filter.call(el.parentNode.children, function(c){ return c.hasAttribute('data-reveal'); });\n        var k = sibs.indexOf(el);\n        if (k > 0) el.style.transitionDelay = Math.min(k, 3) * 110 + 'ms';\n        io.observe(el);\n      });\n      setTimeout(showAll, 3500);\n    } else { showAll(); }\n\n    each(root.querySelectorAll('[data-jump]'), function(a){\n      a.addEventListener('click', function(ev){\n        var t = root.querySelector(a.getAttribute('href'));\n        if (!t) return;\n        ev.preventDefault();\n        var y = t.getBoundingClientRect().top + window.pageYOffset - 24;\n        window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });\n      });\n    });\n\n    function cycler(group, n, render){\n      var i = 0, timer = null, visible = false;\n      function play(){ if (!timer && !reduce && visible) timer = setInterval(function(){ i = (i + 1) % n; render(i); }, DWELL); }\n      function stop(){ if (timer){ clearInterval(timer); timer = null; } }\n      function go(k){ stop(); i = k; render(i); play(); }\n      render(0);\n      if (reduce) return go;\n      if (hasIO) {\n        new IntersectionObserver(function(entries){\n          entries.forEach(function(e){ visible = e.isIntersecting; if (visible){ i = 0; render(0); play(); } else { stop(); } });\n        }, { threshold: 0.35 }).observe(group);\n      } else { visible = true; play(); }\n      document.addEventListener('visibilitychange', function(){ if (document.hidden) stop(); else play(); });\n      return go;\n    }\n\n    each(root.querySelectorAll('[data-cycler]'), function(group){\n      var slides = group.querySelectorAll('.siv-clump__slide');\n      var titles = group.querySelectorAll('.siv-clump__card-title span');\n      var segs = group.querySelectorAll('.siv-clump__seg');\n      var num = group.querySelector('[data-num]');\n      group.style.setProperty('--dwell', DWELL + 'ms');\n      var go = cycler(group, slides.length, function(k){\n        each(slides, function(el, j){ el.classList.toggle('is-on', j === k); });\n        each(titles, function(el, j){ el.classList.toggle('is-on', j === k); });\n        each(segs, function(el, j){ el.classList.remove('is-on'); el.classList.toggle('is-done', j < k); });\n        if (segs[k]) { void segs[k].offsetWidth; segs[k].classList.add('is-on'); }\n        if (num) num.textContent = '0' + (k + 1) + ' / 0' + slides.length;\n      });\n      each(segs, function(el, j){ el.addEventListener('click', function(){ go(j); }); });\n    });\n\n    each(root.querySelectorAll('[data-scent]'), function(group){\n      var stops = group.querySelectorAll('.siv-clump__stop');\n      var dot = group.querySelector('.siv-clump__dot');\n      var pos = ['0%', '50%', '100%'];\n      var go = cycler(group, stops.length, function(k){\n        each(stops, function(el, j){ el.classList.toggle('is-on', j === k); });\n        if (dot) dot.style.left = pos[k];\n      });\n      each(stops, function(el, j){ el.addEventListener('click', function(){ go(j); }); });\n    });\n  });\n})();\n</script>",
