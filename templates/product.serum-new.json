        "ai_gen_block_183bc97_GXRaiQ": {
          "type": "ai_gen_block_183bc97",
          "settings": {
            "custom_html": "<!-- SIV - \"Is clumping normal with our serum?\" section.\n     Paste this entire block into the Custom HTML block on the product page.\n     Images are hardcoded Shopify CDN URLs. Fonts: see the note in the CSS below. -->\n\n\n<style>\n/* ---------------------------------------------------------------\n   FONTS\n   Display (Titling Gothic FB Condensed) is embedded below -- the same cut\n   as the site product-title headers.\n\n   Body (Matter Regular + Bold) is embedded too. Nothing to upload, no\n   external font requests -- the block is fully self-contained.\n   --------------------------------------------------------------- */\n/* ---------------------------------------------------------------\n   TYPOGRAPHY - matches the live theme exactly. No fonts are loaded\n   here: the theme already defines \"Gothic\" (Titling Gothic FB\n   Compressed Standard, weight 400 only) for headings and \"Matter\"\n   (400/500/600) for body, so this block just uses those families.\n   Heading rules mirror the theme: uppercase, line-height 1, weight 400,\n   h2 / h3 clamp sizes.\n   --------------------------------------------------------------- */\n\n.siv-clump{\n  --ink:#121212; --cream:#efefe9; --stone:#a8a39c; --ink-500:#6b6560; --ink-200:#c9c5be;\n  --ease:cubic-bezier(.22,.61,.36,1);\n  --disp:Gothic,sans-serif;\n  --body-font:Matter,sans-serif;\n  --body:Matter,sans-serif;\n  /* full-bleed out of any theme container */\n  width:100vw; max-width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw);\n  box-sizing:border-box; background:var(--cream); color:var(--ink);\n  font-family:var(--body); -webkit-font-smoothing:antialiased; overflow:hidden;\n}\n.siv-clump *,.siv-clump *::before,.siv-clump *::after{box-sizing:border-box;}\n.siv-clump p{margin:0;}\n.siv-clump h2,.siv-clump h3{margin:0;font-family:var(--disp);font-weight:400;line-height:1;letter-spacing:0;text-transform:uppercase;}\n.siv-clump img{display:block;max-width:100%;}\n\n.siv-clump__top{max-width:1440px;margin:0 auto;padding:clamp(56px,6vw,112px) clamp(20px,5vw,64px) clamp(48px,5vw,96px);\n  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(40px,6vw,88px);align-items:start;}\n.siv-clump__col{display:flex;flex-direction:column;gap:clamp(20px,2vw,28px);}\n.siv-clump__eyebrow{display:flex;align-items:center;gap:18px;font-family:var(--body);font-weight:600;\n  font-size:13px;letter-spacing:.22em;text-transform:uppercase;}\n.siv-clump__rule{display:block;height:1px;width:72px;background:rgba(18,18,18,.25);}\n.siv-clump__q{font-size:clamp(2.4rem,5.6vw,4rem);}\n.siv-clump__body{display:flex;flex-direction:column;gap:22px;max-width:560px;}\n.siv-clump__lede{font-family:var(--disp);font-weight:400;font-size:clamp(1.5rem,2.6vw,2.25rem);line-height:1;\n  letter-spacing:0;text-transform:uppercase;}\n.siv-clump__p{font-size:clamp(17px,1.35vw,19px);line-height:1.55;text-wrap:pretty;}\n.siv-clump__p strong{font-weight:700;}\n\n.siv-clump__media{display:flex;flex-direction:column;gap:24px;}\n.siv-clump__frame{position:relative;width:100%;aspect-ratio:16/11;background:#fff;border-radius:4px;overflow:hidden;}\n.siv-clump__frame img{position:absolute;inset:0;margin:auto;height:78%;width:auto;opacity:0;\n  transition:opacity 900ms var(--ease);}\n.siv-clump__frame img.is-on{opacity:1;}\n.siv-clump__cap{font-family:var(--body);font-weight:600;font-size:12px;letter-spacing:.22em;\n  text-transform:uppercase;color:var(--ink-500);}\n.siv-clump__states{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}\n.siv-clump__state{display:flex;flex-direction:column;gap:12px;}\n.siv-clump__bar{height:2px;width:100%;background:rgba(18,18,18,.14);transition:background 400ms var(--ease);}\n.siv-clump__label{font-size:15px;line-height:1.4;color:var(--ink-500);transition:color 400ms var(--ease);}\n.siv-clump__state.is-on .siv-clump__bar{background:var(--ink);}\n.siv-clump__state.is-on .siv-clump__label{color:var(--ink);}\n\n.siv-clump__dark{background:var(--ink);color:var(--cream);}\n.siv-clump__darkinner{max-width:1440px;margin:0 auto;padding:clamp(56px,5vw,88px) clamp(20px,5vw,64px) clamp(56px,5vw,84px);\n  display:flex;flex-direction:column;gap:clamp(36px,4vw,52px);}\n.siv-clump__darkhead{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;\n  border-bottom:1px solid rgba(239,239,233,.22);padding-bottom:34px;}\n.siv-clump__darkhead h3{font-size:clamp(2.4rem,5.6vw,4rem);line-height:1;}\n.siv-clump__logo{width:72px;height:auto;flex:0 0 auto;filter:brightness(0) invert(1);}\n.siv-clump__steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(28px,4vw,56px);}\n.siv-clump__step{display:flex;flex-direction:column;gap:18px;}\n.siv-clump__num{font-family:var(--body);font-weight:600;font-size:12px;letter-spacing:.22em;color:var(--stone);}\n.siv-clump__close{display:flex;align-items:baseline;justify-content:space-between;gap:40px;flex-wrap:wrap;}\n.siv-clump__close .siv-clump__p{max-width:720px;color:var(--ink-200);}\n.siv-clump__mark{font-family:var(--body);font-weight:600;font-size:12px;letter-spacing:.22em;\n  text-transform:uppercase;color:var(--stone);}\n\n.siv-clump [data-reveal]{opacity:0;transform:translateY(18px);\n  transition:opacity 600ms var(--ease),transform 600ms var(--ease);}\n.siv-clump [data-reveal].is-in{opacity:1;transform:none;}\n.siv-clump.no-js [data-reveal],.siv-clump [data-reveal].is-in{opacity:1;transform:none;}\n\n@media (max-width:1023px){\n  .siv-clump__top{grid-template-columns:minmax(0,1fr);}\n  .siv-clump__media{order:-1;}\n  .siv-clump__body{max-width:none;}\n  .siv-clump__steps{grid-template-columns:minmax(0,1fr);gap:32px;}\n  .siv-clump__darkhead{align-items:center;}\n}\n@media (max-width:599px){\n  .siv-clump__frame{aspect-ratio:1/1;}\n  .siv-clump__frame img{height:86%;}\n  .siv-clump__states{grid-template-columns:minmax(0,1fr);gap:14px;}\n  .siv-clump__state{flex-direction:row;align-items:baseline;gap:14px;}\n  .siv-clump__bar{width:28px;flex:0 0 28px;margin-top:9px;}\n  .siv-clump__rule{width:40px;}\n  .siv-clump__logo{width:56px;}\n}\n@media (prefers-reduced-motion:reduce){\n  .siv-clump [data-reveal],.siv-clump__frame img,.siv-clump__bar,.siv-clump__label{transition:none;}\n  .siv-clump [data-reveal]{opacity:1;transform:none;}\n}\n</style>\n\n<section class=\"siv-clump\" data-siv-clump=\"\" aria-label=\"Is clumping normal with our serum\">\n  <div class=\"siv-clump__top\">\n    <div class=\"siv-clump__col\">\n      <div class=\"siv-clump__eyebrow\" data-reveal=\"\">\n        <span>Ask SIV</span><span class=\"siv-clump__rule\"></span>\n      </div>\n      <h2 class=\"siv-clump__q\" data-reveal=\"\">Is clumping normal with our serum?</h2>\n      <div class=\"siv-clump__body\" data-reveal=\"\">\n        <p class=\"siv-clump__lede\">Yes. And they won’t fully disappear.</p>\n        <p class=\"siv-clump__p\">Our serum is formulated without fillers or suspension agents. Nothing in the bottle is there to hold the particles (the Bacillus spores) in place or make them invisible, so natural settling and clumping are expected.</p>\n        <p class=\"siv-clump__p\">Shaking lifts the particles and spreads them through the liquid. It does not dissolve them. You will still see them after shaking, in a range of sizes, and that is exactly what you should see. They melt into the skin on application.</p>\n      </div>\n    </div>\n\n    <div class=\"siv-clump__media\" data-reveal=\"\">\n      <div class=\"siv-clump__frame\">\n        <img class=\"is-on\" data-slide=\"0\" src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/siv-dropper-1.png?v=1786920455\" alt=\"Bottom of the dropper showing visible beige clumps\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n        <img data-slide=\"1\" src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/siv-dropper-2.png?v=1786920456\" alt=\"Bottom of the dropper showing particles beginning to disperse\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n        <img data-slide=\"2\" src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/siv-dropper-3.png?v=1786920457\" alt=\"Bottom of the dropper showing suspended particles of varying sizes\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n      </div>\n      <div class=\"siv-clump__cap\">(Pictured Bottom of Dropper)</div>\n      <div class=\"siv-clump__states\">\n        <div class=\"siv-clump__state is-on\" data-state=\"0\">\n          <div class=\"siv-clump__bar\"></div>\n          <div class=\"siv-clump__label\">Visible clumps after shipping</div>\n        </div>\n        <div class=\"siv-clump__state\" data-state=\"1\">\n          <div class=\"siv-clump__bar\"></div>\n          <div class=\"siv-clump__label\">Particles begin to disperse</div>\n        </div>\n        <div class=\"siv-clump__state\" data-state=\"2\">\n          <div class=\"siv-clump__bar\"></div>\n          <div class=\"siv-clump__label\">Suspended particles, sizes will vary</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"siv-clump__dark\">\n    <div class=\"siv-clump__darkinner\">\n      <div class=\"siv-clump__darkhead\" data-reveal=\"\">\n        <h3>How to use the serum</h3>\n        <img class=\"siv-clump__logo\" src=\"https://cdn.shopify.com/s/files/1/0799/1315/6923/files/SIV_Logo_White.svg?v=1786920450\" alt=\"SIV\" width=\"72\" height=\"24\" loading=\"lazy\">\n      </div>\n\n      <div class=\"siv-clump__steps\">\n        <div class=\"siv-clump__step\" data-reveal=\"\">\n          <div class=\"siv-clump__num\">01</div>\n          <p class=\"siv-clump__p\">Shake vigorously before every application until the sediment lifts off the bottom and spreads evenly through the liquid. You will still see particles suspended in the serum. That is the formula working as designed.</p>\n        </div>\n        <div class=\"siv-clump__step\" data-reveal=\"\">\n          <div class=\"siv-clump__num\">02</div>\n          <p class=\"siv-clump__p\">Set the bottle down and the particles begin to settle again within minutes. Perfectly normal. <strong>Shake again at your next application.</strong></p>\n        </div>\n        <div class=\"siv-clump__step\" data-reveal=\"\">\n          <div class=\"siv-clump__num\">03</div>\n          <p class=\"siv-clump__p\">Temperature during shipping plays a role. Colder regions may see tighter clusters at first, other areas won’t see it at all. A few extra shakes will always bring everything back to an even, consistent suspension.</p>\n        </div>\n      </div>\n\n      <div class=\"siv-clump__close\" data-reveal=\"\">\n        <p class=\"siv-clump__p\">Your serum’s natural movement is a sign of its purity and potency. If you ever have questions, our team is here to support you every step of the way.</p>\n        <div class=\"siv-clump__mark\">Tiny bacteria. Big deal.®</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var roots = document.querySelectorAll('[data-siv-clump]');\n  Array.prototype.forEach.call(roots, function(root){\n    if (root.dataset.sivInit) return;\n    root.dataset.sivInit = '1';\n\n    var items = root.querySelectorAll('[data-reveal]');\n    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (reduce || !('IntersectionObserver' in window)) {\n      Array.prototype.forEach.call(items, function(el){ el.classList.add('is-in'); });\n    } else {\n      var io = new IntersectionObserver(function(entries){\n        entries.forEach(function(e){\n          if (!e.isIntersecting) return;\n          e.target.classList.add('is-in');\n          io.unobserve(e.target);\n        });\n      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });\n      Array.prototype.forEach.call(items, function(el, i){\n        el.style.transitionDelay = (Math.min(i, 4) * 80) + 'ms';\n        io.observe(el);\n      });\n      setTimeout(function(){\n        Array.prototype.forEach.call(items, function(el){ el.classList.add('is-in'); });\n      }, 2500);\n    }\n\n    var slides = root.querySelectorAll('[data-slide]');\n    var states = root.querySelectorAll('[data-state]');\n    if (!slides.length) return;\n    var i = 0, timer = null;\n    function show(n){\n      i = n;\n      Array.prototype.forEach.call(slides, function(el, k){ el.classList.toggle('is-on', k === n); });\n      Array.prototype.forEach.call(states, function(el, k){ el.classList.toggle('is-on', k === n); });\n    }\n    function play(){ if (!timer && !reduce) timer = setInterval(function(){ show((i + 1) % slides.length); }, 2600); }\n    function stop(){ if (timer) { clearInterval(timer); timer = null; } }\n\n    Array.prototype.forEach.call(states, function(el, k){\n      el.style.cursor = 'pointer';\n      el.addEventListener('click', function(){ stop(); show(k); });\n    });\n\n    var frame = root.querySelector('.siv-clump__frame');\n    if (frame) { frame.addEventListener('mouseenter', stop); frame.addEventListener('mouseleave', play); }\n\n    if ('IntersectionObserver' in window) {\n      new IntersectionObserver(function(entries){\n        entries.forEach(function(e){ e.isIntersecting ? play() : stop(); });\n      }, { threshold: 0.2 }).observe(frame || root);\n    } else { play(); }\n\n    document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : play(); });\n  });\n})();\n</script>",
