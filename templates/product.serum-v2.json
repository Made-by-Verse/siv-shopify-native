        },
        "benefit_2": {
          "type": "benefit",
          "settings": {
            "heading": "Leaves skin soft and glowing",
            "text": "<p>Skin-identical oils lock in moisture and leave a soft, healthy glow that you can see and feel through the day.</p>"
          }
        },
        "benefit_3": {
          "type": "benefit",
          "settings": {
            "heading": "Helps skin stay resilient",
            "text": "<p>With daily use, your skin is better able to handle what each day brings, from dry air to a stressful week.</p>"
          }
        }
      },
