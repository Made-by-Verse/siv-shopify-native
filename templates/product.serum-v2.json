    "siv_ingredients": {
      "type": "siv-pdp-ingredients",
      "settings": {
        "eyebrow": "Full ingredient list",
        "heading": "Ingredients",
        "intro": "<p>A lightweight, stabilizing formula made with skin-friendly oils and our proprietary spore blend, so it feels at home on your skin from the first drop.</p>"
      },
      "blocks": {
        "ingr_1": {
          "type": "ingredient",
          "settings": {
            "label": "Biomimetic oil",
            "name": "Squalane",
            "text": "<p>Biomimetic oil, molecule derived from non-GMO sugarcane that mimics squalene, beneficial in promoting skin hydration</p>"
          }
        },
        "ingr_2": {
          "type": "ingredient",
          "settings": {
            "label": "Moisture barrier",
            "name": "Caprylic / Capric Triglyceride",
            "text": "<p>A mixture of caprylic and capric fatty acids derived from palm oil; help replenish skin's surface and help it to resist moisture loss</p>"
          }
        },
        "ingr_3": {
          "type": "ingredient",
          "settings": {
            "label": "Emollient",
            "name": "Glyceryl Caprylate",
            "text": "<p>A natural, plant-based, emollient derived from glycerin and plant fatty acids; restores the oils of the skin, helps the skin hold on to moisture and acts as a humidifier to the skin</p>"
          }
        },
        "ingr_4": {
          "type": "ingredient",
          "settings": {
            "label": "Proprietary spore blend",
            "name": "Bacillus",
            "text": "<p>A proprietary blend of Bacillus spores support a healthy skin foundation and visibly improves skin. Positively influencing your unique skin biome and establishing balance. The spores can help improve the skin microbiome by targeting overgrown bacteria, while facilitating the growth of other essential species- effectively balancing the skin microbiome.</p>"
          }
        }
      },
      "block_order": [
        "ingr_1",
        "ingr_2",
        "ingr_3",
        "ingr_4"
      ]
    },
