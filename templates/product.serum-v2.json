    "siv_faq": {
      "type": "siv-pdp-faq",
      "settings": {
        "eyebrow": "Questions",
        "heading": "Good to know",
        "intro": "<p>Still curious? Write to us at <a href=\"mailto:info@sivcare.com\" title=\"mailto:info@sivcare.com\">info@sivcare.com</a> and we will be glad to help.</p>",
        "open_first": true
      },
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "I see small clumps in my serum. Is that normal?",
            "answer": "<p>Yes, and it is a sign the spores are there. Because the formula has no fillers or suspension agents, the spores settle between uses and can form soft clusters, especially after cold shipping. Shake well before each use and any remaining particles will melt into your skin.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Does the serum have a scent?",
            "answer": "<p>There is no added fragrance. A light natural scent may be noticeable when you first open the bottle, and it fades quickly after application.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "<p>The 15 mL bottle lasts about 30 days and is perfect if you are trying the serum for the first time. The 30 mL bottle lasts about 60 days and offers better value.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for sensitive skin?",
            "answer": "<p>Yes. The serum is dermatologist approved, non-comedogenic and suitable for dry, normal and oily skin. If your skin is highly sensitive, patch test first.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "What comes in the bottle?",
            "answer": "<p>The serum comes in a 15 mL or 30 mL glass bottle with a precision dropper, so it is easy to dispense 1 to 3 drops each day.</p>"
          }
        }
      },
      "block_order": [
        "q_1",
        "q_2",
        "q_3",
        "q_4",
        "q_5"
      ]
    },
