        "accordion_8j3UFB": {
          "type": "accordion",
          "settings": {
            "heading": "I am a wholesaler in Australia or New Zealand. How do I sign up for a wholesale account?",
            "content": "<p>For New Zealand stockists please contact: <a href=\"mailto:support@fxmed.co.nz\" target=\"_blank\">support@fxmed.co.nz</a></p><p>For Australian stockists please contact: <a href=\"mailto:support@therahealth.com.au\" target=\"_blank\">support@therahealth.com.au</a></p>"
          }
        },
        "accordion_8Tgk3E": {
          "type": "accordion",
          "settings": {
            "heading": "Do you ship to Canada?",
