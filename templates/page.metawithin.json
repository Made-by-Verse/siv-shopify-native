ase;\n    margin-bottom: 24px;\n  }\n\n  .meta-purchase-box {\n    background: #ffffff;\n    border: 1px solid rgba(0,0,0,.16);\n    border-radius: 12px;\n    padding: 17px 18px;\n    margin-bottom: 14px;\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    font-size: 15px;\n  }\n\n  .meta-radio {\n    width: 18px;\n    height: 18px;\n    border: 5px solid #111111;\n    border-radius: 50%;\n    box-sizing: border-box;\n  }\n\n  .meta-buy-button {\n    width: 100%;\n    border: 0;\n    border-radius: 12px;\n    background: #111111;\n    color: #ffffff;\n    padding: 20px 22px;\n    font-size: 14px;\n    font-weight: 600;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: transform .2s ease, opacity .2s ease;\n  }\n\n  .meta-buy-button:hover {\n    transform: translateY(-2px);\n    opacity: .9;\n  }\n\n  .meta-buy-button:disabled {\n    opacity: .5;\n    cursor: wait;\n  }\n\n  .meta-fine-print {\n    margin-top: 12px;\n    font-size: 12px;\n    opacity: .55;\n    text-align: center;\n  }\n\n  @media (max-width: 749px) {\n    .meta-within-page {\n      padding: 22px 16px 44px;\n    }\n\n    .meta-within-inner {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n\n    .meta-within-image-wrap {\n      padding: 24px;\n      border-radius: 16px;\n    }\n\n    .meta-within-title {\n      font-size: 44px;\n    }\n  }\n</style>\n\n{% if meta_product != blank %}\n<section class=\"meta-within-page\">\n  <div class=\"meta-within-inner\">\n\n    <div class=\"meta-within-image-wrap\">\n      {% if meta_product.featured_image %}\n        {{\n          meta_product.featured_image\n          | image_url: width: 1200\n          | image_tag:\n            class: 'meta-within-image',\n            loading: 'eager',\n            alt: meta_product.title\n        }}\n      {% endif %}\n    </div>\n\n    <div class=\"meta-within-content\">\n\n      <div class=\"meta-within-eyebrow\">\n        SIV · Daily Internal Skin Support\n      </div>\n\n      <h1 class=\"meta-within-title\">\n        {{ meta_product.title }}\n      </h1>\n\n      <div class=\"meta-within-description\">\n        {{ meta_product.description }}\n      </div>\n\n      <div class=\"meta-price-row\">\n        <span class=\"meta-original-price\">\n          {{ meta_variant.price | money }}\n        </span>\n\n        <span class=\"meta-sale-price\">\n          {{ meta_variant.price | times: 0.8 | money }}\n        </span>\n      </div>\n\n      <div class=\"meta-offer-pill\">\n        20% Off Automatically With FIRST20\n      </div>\n\n      <div class=\"meta-purchase-box\">\n        <span class=\"meta-radio\"></span>\n        <span>One-Time Purchase</span>\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"meta-buy-button\"\n        id=\"MetaWithinBuy\"\n        data-variant-id=\"{{ meta_variant.id }}\"\n      >\n        Get Biome Balance Within\n      </button>\n\n      <div class=\"meta-fine-print\">\n        FIRST20 will be automatically applied at checkout.\n      </div>\n\n    </div>\n  </div>\n</section>\n{% endif %}\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  const button = document.getElementById('MetaWithinBuy');\n\n  if (!button) return;\n\n  button.addEventListener('click', async function () {\n    const variantId = button.dataset.variantId;\n\n    button.disabled = true;\n    button.textContent = 'ADDING...';\n\n    try {\n      const response = await fetch('/cart/add.js', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json'\n        },\n        body: JSON.stringify({\n          items: [\n            {\n              id: Number(variantId),\n              quantity: 1\n            }\n          ]\n        })\n      });\n\n      if (!response.ok) {\n        throw new Error('Unable to add item');\n      }\n\n      window.location.href = '/discount/FIRST20?redirect=/checkout';