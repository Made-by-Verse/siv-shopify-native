within-copy\">\n        {{ product.description | strip_html | truncatewords: 42 }}\n      </div>\n\n      <div class=\"meta-price-row\">\n        <span class=\"meta-old-price\">\n          {{ current_variant.price | money }}\n        </span>\n\n        <span class=\"meta-sale-price\">\n          {{ current_variant.price | times: 0.8 | money }}\n        </span>\n      </div>\n\n      <div class=\"meta-discount\">\n        20% Off With FIRST20\n      </div>\n\n      <div class=\"meta-purchase-label\">\n        <span class=\"meta-radio\"></span>\n        <span>One-Time Purchase</span>\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"meta-buy-button\"\n        id=\"MetaWithinBuy\"\n        data-variant-id=\"{{ current_variant.id }}\"\n      >\n        Get Biome Balance Within\n      </button>\n\n      <div class=\"meta-fine-print\">\n        FIRST20 is automatically applied at checkout.\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const button = document.getElementById('MetaWithinBuy');\n\n  if (!button) return;\n\n  button.addEventListener('click', async function() {\n    const variantId = button.dataset.variantId;\n\n    button.disabled = true;\n    button.textContent = 'ADDING...';\n\n    try {\n      const response = await fetch('/cart/add.js', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Accept': 'application/json'\n        },\n        body: JSON.stringify({\n          items: [\n            {\n              id: Number(variantId),\n              quantity: 1\n            }\n          ]\n        })\n      });\n\n      if (!response.ok) {\n        throw new Error('Could not add product.');\n      }\n\n      window.location.href = '/discount/FIRST20?redirect=/checkout';\n\n    } catch (error) {\n      console.error(error);\n      button.disabled = false;\n      button.textContent = 'GET BIOME BALANCE WITHIN'