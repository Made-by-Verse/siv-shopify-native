v-detail-body ul{padding-left:18px}\n\n    /* THREE BENEFITS */\n    #siv-serum-lp .siv-three{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #111;border-bottom:1px solid #111}\n    #siv-serum-lp .siv-three > div{padding:58px 46px;min-height:220px}\n    #siv-serum-lp .siv-three > div+div{border-left:1px solid #111}\n    #siv-serum-lp .siv-three h3{font-size:28px}\n    #siv-serum-lp .siv-three p{font-size:14px;max-width:340px;margin:0}\n\n    /* SIZE / HOW TO */\n    #siv-serum-lp .siv-supply{\n      display:grid;grid-template-columns:1.05fr .95fr;align-items:stretch;background:#0a0a0a;color:white;\n    }\n    #siv-serum-lp .siv-supply-image img{height:100%;min-height:680px;object-fit:cover}\n    #siv-serum-lp .siv-supply-copy{padding:80px clamp(34px,6vw,100px);display:flex;flex-direction:column;justify-content:center}\n    #siv-serum-lp .siv-supply-copy h2{font-size:clamp(38px,5vw,76px)}\n    #siv-serum-lp .siv-size-line{padding:22px 0;border-top:1px solid rgba(255,255,255,.35)}\n    #siv-serum-lp .siv-size-line:last-of-type{border-bottom:1px solid rgba(255,255,255,.35)}\n    #siv-serum-lp .siv-size-line strong{font-size:18px;display:block;margin-bottom:5px}\n\n    /* SCIENCE CARDS */\n    #siv-serum-lp .siv-science{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#111;border-top:1px solid #111;border-bottom:1px solid #111}\n    #siv-serum-lp .siv-science-card{background:#fff;padding:54px 34px 48px;min-height:520px;display:flex;flex-direction:column}\n    #siv-serum-lp .siv-science-icon{height:230px;display:flex;align-items:center;justify-content:center;margin-bottom:28px}\n    #siv-serum-lp .siv-science-icon img{max-height:210px;object-fit:contain}\n    #siv-serum-lp .siv-science-card p{font-size:14px;margin-bottom:0}\n\n    /* RESULTS */\n    #siv-serum-lp .siv-results-head{text-align:center;max-width:980px;margin:0 auto 56px}\n    #siv-serum-lp .siv-results-head p{font-size:15px;color:#444}\n    #siv-serum-lp .siv-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:50px 28px}\n    #siv-serum-lp .siv-result{border-top:1px solid #111;padding-top:12px}\n    #siv-serum-lp .siv-result-copy{min-height:90px;display:grid;grid-template-columns:1fr auto;gap:22px;align-items:start}\n    #siv-serum-lp .siv-result-copy p{font-size:13px;line-height:1.5;margin:0}\n    #siv-serum-lp .siv-days{font-size:12px;text-transform:uppercase;letter-spacing:.1em;white-space:nowrap;font-weight:700}\n    #siv-serum-lp .siv-ba{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:#fff}\n    #siv-serum-lp .siv-ba-img{position:relative;background:#eee;overflow:hidden;aspect-ratio:1/1}\n    #siv-serum-lp .siv-ba-img img{width:100%;height:100%;object-fit:cover}\n    #siv-serum-lp .siv-ba-label{position:absolute;left:10px;top:10px;background:rgba(255,255,255,.88);padding:7px 10px;font-size:10px;text-transform:uppercase;letter-spacing:.13em;font-weight:700}\n\n    /* INGREDIENTS */\n    #siv-serum-lp .siv-ingredient-heading{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;margin-bottom:46px}\n    #siv-serum-lp .siv-ingredient-heading p{font-size:14px;max-width:600px}\n    #siv-serum-lp .siv-ingredients{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid #111;border-left:1px solid #111}\n    #siv-serum-lp .siv-ingredient{display:grid;grid-template-columns:44% 56%;min-height:360px;border-right:1px solid #111;border-bottom:1px solid #111;background:#fff}\n    #siv-serum-lp .siv-ingredient img{height:100%;min-height:360px;object-fit:cover}\n    #siv-serum-lp .siv-ingredient-copy{padding:34px;display:flex;flex-direction:column;justify-content:center}\n    #siv-serum-lp .siv-ingredient-copy h3{font-size:27px}\n    #siv-serum-lp .siv-ingredient-copy p{font-size:13px;line-height:1.6;margin:0}\n\n    /* CTA */\n    #siv-serum-lp .siv-final{text-align:center;padding:110px 24px;background:#111;color:#fff}\n    #siv-serum-lp .siv-final h2{max-width:950px;margin:0 auto