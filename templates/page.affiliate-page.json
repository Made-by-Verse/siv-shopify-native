r Skin From the Inside Out.\n  </h2>\n\n  <p>\n    Pair Biome Balancing Daily Serum with Biome Balance Within\n    for a complete inside-and-out approach to skin resilience.\n  </p>\n\n  <button type=\"button\" id=\"sivReturnTop\">\n\n    Shop the Routine\n\n  </button>\n\n</section>\n\n\n\n<script>\n\n(function(){\n\n  const root =\n    document.getElementById(\"siv-landing-page\");\n\n  if(!root) return;\n\n\n\n  /* =====================================\n     SHOPIFY HELPERS\n  ===================================== */\n\n  function shopifyRoot(){\n\n    if(\n      window.Shopify &&\n      window.Shopify.routes &&\n      window.Shopify.routes.root\n    ){\n\n      return window.Shopify.routes.root;\n\n    }\n\n    return \"/\";\n\n  }\n\n\n  function formatMoney(cents){\n\n    try{\n\n      return new Intl.NumberFormat(\n        \"en-US\",\n        {\n          style:\"currency\",\n          currency:\"USD\"\n        }\n      ).format(cents / 100);\n\n    }\n\n    catch(e){\n\n      return \"$\" + (cents / 100).toFixed(2);\n\n    }\n\n  }\n\n\n  async function addItemToCart(\n    variantId,\n    quantity\n  ){\n\n    const response =\n      await fetch(\n        shopifyRoot() + \"cart/add.js\",\n        {\n\n          method:\"POST\",\n\n          headers:{\n            \"Content-Type\":\"application/json\",\n            \"Accept\":\"application/json\"\n          },\n\n          credentials:\"same-origin\",\n\n          body:JSON.stringify({\n\n            items:[\n              {\n                id:Number(variantId),\n                quantity:Number(quantity)\n              }\n            ]\n\n          })\n\n        }\n      );\n\n\n    if(!response.ok){\n\n      let message =\n        \"Unable to add this product to cart.\";\n\n      try{\n\n        const error =\n          await response.json();\n\n        message =\n          error.description ||\n          error.message ||\n          message;\n\n      }\n\n      catch(e){}\n\n      throw new Error(message);\n\n    }\n\n\n    const result =\n      await response.json();\n\n\n    document.dispatchEvent(\n      new CustomEvent(\n        \"cart:refresh\",\n        {\n          bubbles:true\n        }\n      )\n    );\n\n\n    document.dispatchEvent(\n      new CustomEvent(\n        \"cart:updated\",\n        {\n          bubbles:true\n        }\n      )\n    );\n\n\n    return result;\n\n  }\n\n\n\n  /* =====================================\n     SERUM GALLERY\n  ===================================== */\n\n  const serumMainImage =\n    root.querySelector(\n      \"#sivSerumImage\"\n    );\n\n\n  root.querySelectorAll(\n    \"[data-serum-image]\"\n  ).forEach(\n    function(button){\n\n      button.addEventListener(\n        \"click\",\n        function(){\n\n          serumMainImage.src =\n            button.dataset.serumImage;\n\n\n          root.querySelectorAll(\n            \"[data-serum-image]\"\n          ).forEach(\n            function(item){\n\n              item.classList.remove(\n                \"is-active\"\n              );\n\n            }\n          );\n\n\n          button.classList.add(\n            \"is-active\"\n          );\n\n        }\n      );\n\n    }\n  );\n\n\n\n  /* =====================================\n     SERUM\n  ===================================== */\n\n  const SERUM_VARIANTS = {\n\n    \"50674962366779\":{\n      price:null\n    },\n\n    \"50674962399547\":{\n      price:null\n    }\n\n  };\n\n\n  let selectedSerumVariant =\n    \"50674962366779\";\n\n\n  const serumPrice =\n    root.querySelector(\n      \"#sivSerumPrice\"\n    );\n\n  const serumQty =\n    root.querySelector(\n      \"#sivSerumQty\"\n    );\n\n  const serumStatus =\n    root.querySelector(\n      \"#sivSerumStatus\"\n    );\n\n  const serumATC =\n    root.querySelector(\n      \"#sivSerumATC\"\n    );\n\n\n  root.querySelector(\n    \"#sivSerumMinus\"\n  ).addEventListener(\n    \"click\",\n    function(){\n\n      serumQty.value =\n        Math.max(\n          1,\n          parseInt(\n            serumQty.value || \"1\",\n            10\n          ) - 1\n        );\n\n    }\n  );\n\n\n  root.querySelector(\n    \"#sivSerumPlus\"\n  ).addEventListener(\n    \"click\",\n    function(){\n\n      serumQty.value =\n        Math.max(\n          1,\n          parseInt(\n            serumQty.value || \"1\",\n            10\n          ) + 1\n        );\n\n    }\n  );\n\n\n  serumQty.addEventListener(\n    \"change\",\n    function(){\n\n      serumQty.value =\n        Math.max(\n          1,\n          parseInt(\n            serumQty.value || \"1\",\n            10\n          )\n        );\n\n    }\n  );\n\n\n  root.querySelectorAll(\n    \"[data-serum-variant]\"\n  ).forEach(\n    function(button){\n\n      button.addEventListener(\n        \"click\",\n        function(){\n\n          selectedSerumVariant =\n            String(\n              button.dataset.serumVariant\n            );\n\n\n          root.querySelectorAll(\n            \"[data-serum-variant]\"\n          ).forEach(\n            function(item){\n\n              item.classList.remove(\n                \"is-active\"\n              );\n\n            }\n          );\n\n\n          button.classList.add(\n            \"is-active\"\n          );\n\n\n          updateSerumPrice();\n\n        }\n      );\n\n    }\n  );\n\n\n  function updateSerumPrice(){\n\n    const selected =\n      SERUM_VARIANTS[\n        selectedSerumVariant\n      ];\n\n\n    if(\n      selected &&\n      selected.price\n    ){\n\n      serumPrice.textContent =\n        selected.price;\n\n    }\n\n    else{\n\n      serumPrice.textContent =\n        \"Price shown at checkout\";\n\n    }\n\n  }\n\n\n\n  async function loadSerum(){\n\n    try{\n\n      const response =\n        await fetch(\n          shopifyRoot() +\n          \"products/siv-biome-balancing-serum.js\",\n          {\n            credentials:\"same-origin\"\n          }\n        );\n\n\n      if(!response.ok){\n\n        throw new Error();\n\n      }\n\n\n      const product =\n        await response.json();\n\n\n      product.variants.forEach(\n        function(variant){\n\n          const id =\n            String(variant.id);\n\n\n          if(\n            SERUM_VARIANTS[id]\n          ){\n\n            SERUM_VARIANTS[id].price =\n              formatMoney(\n                variant.price\n              );\n\n          }\n\n        }\n      );\n\n\n      updateSerumPrice();\n\n    }\n\n    catch(e){\n\n      updateSerumPrice();\n\n    }\n\n  }\n\n\n\n  serumATC.addEventListener(\n    \"click\",\n    async function(){\n\n      const quantity =\n        Math.max(\n          1,\n          parseInt(\n            serumQty.value || \"1\",\n            10\n          )\n        );\n\n\n      const original =\n        serumATC.textContent;\n\n\n      serumATC.disabled =\n        true;\n\n      serumATC.textContent =\n        \"Adding…\";\n\n      serumStatus.textContent =\n        \"\";\n\n\n      try{\n\n        await addItemToCart(\n          selectedSerumVariant,\n          quantity\n        );\n\n\n        serumATC.textContent =\n          \"Added ✓\";\n\n        serumStatus.textContent =\n          \"Serum added to cart.\";\n\n\n        setTimeout(\n          function(){\n\n            serumATC.textContent =\n              original;\n\n            serumATC.disabled =\n              false;\n\n          },\n          1400\n        );\n\n      }\n\n      catch(error){\n\n        serumStatus.textContent =\n          error.message;\n\n        serumATC.textContent =\n          original;\n\n        serumATC.disabled =\n          false;\n\n      }\n\n    }\n  );\n\n\n\n  /* =====================================\n     BIOME BALANCE WITHIN\n  ===================================== */\n\n  const WITHIN_HANDLE =\n    \"biome-balance-within\";\n\n\n  let withinVariantId =\n    null;\n\n\n  const withinImage =\n    root.querySelector(\n      \"#sivWithinImage\"\n    );\n\n  const withinTitle =\n    root.querySelector(\n      \"#sivWithinTitle\"\n    );\n\n  const withinPrice =\n    root.querySelector(\n      \"#sivWithinPrice\"\n    );\n\n  const withinQty =\n    root.querySelector(\n      \"#sivWithinQty\"\n    );\n\n  const withinATC =\n    root.querySelector(\n      \"#sivWithinATC\"\n    );\n\n  const withinStatus =\n    root.querySelector(\n      \"#sivWithinStatus\"\n    );\n\n\n\n  root.querySelector(\n    \"#sivWithinMinus\"\n  ).addEventListener(\n    \"click\",\n    function(){\n\n      withinQty.value =\n        Math.max(\n          1,\n          parseInt(\n            withinQty.value || \"1\",\n            10\n          ) - 1\n        );\n\n    }\n  );\n\n\n  root.querySelector(\n    \"#sivWithinPlus\"\n  ).addEventListener(\n    \"click\",\n    function(){\n\n      withinQty.value =\n        Math.max(\n          1,\n          parseInt(\n            withinQty.value || \"1\",\n            10\n          ) + 1\n        );\n\n    }\n  );\n\n\n  withinQty.addEventListener(\n    \"change\",\n    function(){\n\n      withinQty.value =\n        Math.max(\n          1,\n          parseInt(\n            withinQty.value || \"1\",\n            10\n          )\n        );\n\n    }\n  );\n\n\n\n  async function loadWithin(){\n\n    try{\n\n      const response =\n        await fetch(\n          shopifyRoot() +\n          \"products/\" +\n          WITHIN_HANDLE +\n          \".js\",\n          {\n\n            credentials:\"same-origin\",\n\n            headers:{\n              \"Accept\":\"application/json\"\n            }\n\n          }\n        );\n\n\n      if(!response.ok){\n\n        throw new Error(\n          \"Unable to load product.\"\n        );\n\n      }\n\n\n      const product =\n        await response.json();\n\n\n      const variant =\n        product.variants.find(\n          function(item){\n\n            return item.available;\n\n          }\n        ) ||\n        product.variants[0];\n\n\n      if(!variant){\n\n        throw new Error(\n          \"No product variant found.\"\n        );\n\n      }\n\n\n      withinVariantId =\n        Number(\n          variant.id\n        );\n\n\n      if(product.title){\n\n        withinTitle.textContent =\n          product.title.toUpperCase();\n\n      }\n\n\n      if(product.featured_image){\n\n        withinImage.src =\n          product.featured_image;\n\n      }\n\n      else if(\n        product.images &&\n        product.images.length\n      ){\n\n        withinImage.src =\n          product.images[0];\n\n      }\n\n\n      if(\n        typeof variant.price ===\n        \"number\"\n      ){\n\n        withinPrice.textContent =\n          formatMoney(\n            variant.price\n          );\n\n      }\n\n\n      if(\n        variant.available === false\n      ){\n\n        withinATC.disabled =\n          true;\n\n        withinATC.textContent =\n          \"Sold Out\";\n\n        withinStatus.textContent =\n          \"Currently unavailable.\";\n\n      }\n\n      else{\n\n        withinATC.disabled =\n          false;\n\n        withinStatus.textContent =\n          \"\";\n\n      }\n\n    }\n\n\n    catch(error){\n\n      withinATC.disabled =\n        true;\n\n      withinPrice.textContent =\n        \"\";\n\n      withinStatus.textContent =\n        \"Unable to load Biome Balance Within.\";\n\n    }\n\n  }\n\n\n\n  withinATC.addEventListener(\n    \"click\",\n    async function(){\n\n      if(!withinVariantId){\n\n        return;\n\n      }\n\n\n      const quantity =\n        Math.max(\n          1,\n          parseInt(\n            withinQty.value || \"1\",\n            10\n          )\n        );\n\n\n      const original =\n        withinATC.textContent;\n\n\n      withinATC.disabled =\n        true;\n\n      withinATC.textContent =\n        \"Adding…\";\n\n      withinStatus.textContent =\n        \"\";\n\n\n      try{\n\n        await addItemToCart(\n          withinVariantId,\n          quantity\n        );\n\n\n        withinATC.textContent =\n          \"Added ✓\";\n\n        withinStatus.textContent =\n          \"Biome Balance Within added to cart.\";\n\n\n        setTimeout(\n          function(){\n\n            withinATC.textContent =\n              original;\n\n            withinATC.disabled =\n              false;\n\n          },\n          1400\n        );\n\n      }\n\n\n      catch(error){\n\n        withinStatus.textContent =\n          error.message;\n\n        withinATC.textContent =\n          original;\n\n        withinATC.disabled =\n          false;\n\n      }\n\n    }\n  );\n\n\n\n  /* =====================================\n     FINAL BUTTON\n  ===================================== */\n\n  root.querySelector(\n    \"#sivReturnTop\"\n  ).addEventListener(\n    \"click\",\n    function(){\n\n      root.querySelector(\n        \".siv-product-section\"\n      ).scrollIntoView(\n        {\n          behavior:\"smooth\",\n          block:\"start\"\n        }\n      );\n\n    }\n  );\n\n\n\n  /* =====================================\n     LOAD PRODUCTS\n  ===================================== */\n\n  loadSerum();\n\n  loadWithin();\n\n\n})();\n\n</script>\n\n\n</div>",
