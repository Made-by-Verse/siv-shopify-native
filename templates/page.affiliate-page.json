clamp(34px,10vw,46px);\n        line-height:1.04;\n        letter-spacing:-0.015em;\n        max-width:100%;\n      }\n      #siv-serum-lp .siv-subhead{font-size:16px}\n      #siv-serum-lp .siv-description{font-size:14px}\n      #siv-serum-lp .siv-size-grid{grid-template-columns:1fr}\n      #siv-serum-lp .siv-size{min-height:52px}\n      #siv-serum-lp .siv-buy-row{grid-template-columns:1fr}\n      #siv-serum-lp .siv-qty{width:100%;height:52px}\n      #siv-serum-lp .siv-atc{width:100%;height:54px}\n      #siv-serum-lp .siv-three > div{padding:38px 22px}\n      #siv-serum-lp .siv-gallery-thumbs{\n        left:10px;\n        right:10px;\n        bottom:10px;\n        gap:6px;\n        overflow-x:auto;\n        padding:2px;\n        scrollbar-width:none;\n      }\n      #siv-serum-lp .siv-gallery-thumbs::-webkit-scrollbar{display:none}\n      #siv-serum-lp .siv-thumb{\n        width:48px;\n        height:48px;\n        min-width:48px;\n        border-radius:9px;\n      }\n      #siv-serum-lp .siv-thumb img{border-radius:8px}\n      #siv-serum-lp .siv-supply-copy{padding:48px 22px}\n      #siv-serum-lp .siv-science-card{padding:36px 22px}\n      #siv-serum-lp .siv-science-icon{height:160px}\n      #siv-serum-lp .siv-ingredient{grid-template-columns:1fr;min-height:0}\n      #siv-serum-lp .siv-ingredient img{min-height:0;aspect-ratio:16/10}\n      #siv-serum-lp .siv-ingredient-copy{padding:26px 20px 32px}\n      #siv-serum-lp .siv-final{padding:78px 20px}\n    }\n  </style>\n\n  <!-- PRODUCT HERO -->\n  <section class=\"siv-product\">\n    <div class=\"siv-gallery\">\n      <img id=\"sivMainImage\" class=\"siv-main-image\" src=\"https://sivcare.com/cdn/shop/files/SIV_duo_gray-low.jpg?v=1762927294\" alt=\"SIV Biome Balancing Serum 15 mL and 30 mL bottles\">\n      <div class=\"siv-gallery-thumbs\" aria-label=\"Product gallery\">\n        <button class=\"siv-thumb is-active\" type=\"button\" data-image=\"https://sivcare.com/cdn/shop/files/SIV_duo_gray-low.jpg?v=1762927294\" aria-label=\"Serum bottles\">\n          <img src=\"https://sivcare.com/cdn/shop/files/SIV_duo_gray-low.jpg?v=1762927294\" alt=\"\">\n        </button>\n        <button class=\"siv-thumb\" type=\"button\" data-image=\"https://sivcare.com/cdn/shop/files/SIV_both-box_tbbd-low.jpg?v=1762927376\" aria-label=\"Serum packaging\">\n          <img src=\"https://sivcare.com/cdn/shop/files/SIV_both-box_tbbd-low.jpg?v=1762927376\" alt=\"\">\n        </button>\n        <button class=\"siv-thumb\" type=\"button\" data-image=\"https://sivcare.com/cdn/shop/files/SIV-Social_1x1_Ritual-vs-Reset.jpg?v=1762927376\" aria-label=\"15 mL and 30 mL size comparison\">\n          <img src=\"https://sivcare.com/cdn/shop/files/SIV-Social_1x1_Ritual-vs-Reset.jpg?v=1762927376\" alt=\"\">\n        </button>\n        <button class=\"siv-thumb\" type=\"button\" data-image=\"https://sivcare.com/cdn/shop/files/SIV-Social_1x1_Ingredients.jpg?v=1762927376\" aria-label=\"Serum ingredients\">\n          <img src=\"https://sivcare.com/cdn/shop/files/SIV-Social_1x1_Ingredients.jpg?v=1762927376\" alt=\"\">\n        </button>\n        <button class=\"siv-thumb\" type=\"button\" data-image=\"https://sivcare.com/cdn/shop/files/SIV_duo_splash-low_3d63c9e7-58c2-4f16-8d1b-7e96c1b1922b.jpg?v=1762927376\" aria-label=\"Serum bottles in water\">\n          <img src=\"https://sivcare.com/cdn/shop/files/SIV_duo_splash-low_3d63c9e7-58c2-4f16-8d1b-7e96c1b1922b.jpg?v=1762927376\" alt=\"\">\n        </button>\n      </div>\n    </div>\n\n    <div class=\"siv-product-info\">\n      <p class=\"siv-kicker\">SIV</p>\n      <h1>BIOME BALANCING DAILY SERUM</h1>\n      <p class=\"siv-subhead\">An Elevated Experience. The Same Trusted Formula.</p>\n      <div class=\"siv-description\">\n        <p>SIV Biome-Balancing Serum is an innovative, spore-based formula designed to work with your skin's natural biology. The topical formula adapts to your unique skin microbiome, establishing a healthy skin foundation through quorum-sensing technology.</p>\n        <p>This personalized approach supports and strengthens the skin's ecosystem at its foundation, helping build resilience and maintain a balanced skin microbiome while hydrating, calming, and soothing skin.</p>\n        <p>Now available in a refined glass bottle with a precision dropper and two sizes — the same trusted formula in an elevated experience.</p>\n      </div>\n\n      <div class=\"siv-field-label\">Size</div>\n      <div class=\"siv-size-grid\" role=\"group\" aria-label=\"Select serum size\">\n        <button type=\"button\" class=\"siv-size is-active\" data-variant=\"50674962366779\" data-size=\"15mL - 30 Day\">\n          15mL — 30 Day\n        </button>\n        <button type=\"button\" class=\"siv-size\" data-variant=\"50674962399547\" data-size=\"30mL - 60 Day\">\n          30mL — 60 Day\n        </button>\n      </div>\n\n      <div class=\"siv-price\" id=\"sivPrice\">$79.00</div>\n\n      <div class=\"siv-buy-row\">\n        <div class=\"siv-qty\" aria-label=\"Quantity\">\n          <button type=\"button\" id=\"sivQtyMinus\" aria-label=\"Decrease quantity\">−</button>\n          <input id=\"sivQty\" type=\"number\" min=\"1\" value=\"1\" inputmode=\"numeric\" aria-label=\"Quantity\">\n          <button type=\"button\" id=\"sivQtyPlus\" aria-label=\"Increase quantity\">+</button>\n        </div>\n        <button id=\"sivAddToCart\" class=\"siv-atc\" type=\"button\">Add to cart</button>\n      </div>\n      <div class=\"siv-status\" id=\"sivCartStatus\" aria-live=\"polite\"></div>\n\n      <div class=\"siv-accordions\">\n        <details>\n          <summary>Full Ingredients List</summary>\n          <div class=\"siv-detail-body\">\n            <p>Lightweight &amp; stabilizing formula containing physiologically identical ingredients that your skin recognizes.</p>\n            <ul>\n              <li>\n<strong>Squalane:</strong> Biomimetic oil derived from non-GMO sugarcane that mimics squalene and supports skin hydration.</li>\n              <li>\n<strong>Caprylic/Capric Triglyceride:</strong> A mixture of caprylic and capric fatty acids derived from palm oil that helps replenish the skin's surface and resist moisture loss.</li>\n              <li>\n<strong>Glyceryl Caprylate:</strong> A natural, plant-based emollient derived from glycerin and plant fatty acids that helps restore oils and regulate skin moisture.</li>\n              <li>\n<strong>Bacillus:</strong> A proprietary blend of Bacillus spores designed to support a healthy skin foundation and positively influence the unique skin biome.</li>\n            </ul>\n          </div>\n        </details>\n\n        <details>\n          <summary>How to Use</summary>\n          <div class=\"siv-detail-body\">\n            Before use, shake vigorously. Apply 1–3 drops once daily. Pat into dry or damp skin. Apply after cleansing or toning.\n          </div>\n        </details>\n\n        <details>\n          <summary>Benefits</summary>\n          <div class=\"siv-detail-body\">\n            Non-comedogenic · Non-irritating · Clinically tested · Clinically proven · Kind to skin · Safe for skin · Dermatologically tested · Safe for sensitive skin · Dermatologist approved · Suitable for all skin types.\n          </div>\n        </details>\n\n        <details>\n          <summary>Caution</summary>\n          <div class=\"siv-detail-body\">\n            Do not use around or near the eye area. Do not use if allergic to any ingredients. Discontinue use if irritation occurs. Avoid contact with eyes; if contact occurs, immediately rinse with water. If you have highly sensitive skin, test first on a small area of skin.\n          </div>\n        </details>\n\n        <details>\n          <summary>Why the Upgrade</summary>\n          <div class=\"siv-detail-body\">\n            <p><strong>Glass Packaging</strong> — A luxurious, sustainable design that protects the integrity of your serum.</p>\n            <p><strong>Enhanced Usability</strong> — A refined dropper for precise application.</p>\n            <p><strong>More of What You Love</strong> — Available in both 15mL and 30mL.</p>\n            <p><strong>Same Science-Backed Formula</strong> — No change to the formula, just a more premium experience.</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>I see clumps in my serum. Is that normal?</summary>\n          <div class=\"siv-detail-body\">\n            <p>Yes. Natural settling and clumps are expected because the serum is intentionally formulated without fillers or suspension agents. Small white or beige particles are the carriers for the bacterial strains and may settle into a fine beige sediment at the bottom.</p>\n            <p><strong>Shake vigorously</strong> until the sediment is fully dispersed, then apply as usual. The ingredients will naturally settle again after the bottle is set down, so simply shake before each application.</p>\n            <p>Temperature during shipping can also affect how tightly particles cluster. A few extra shakes will return the serum to a fine, even consistency.</p>\n          </div>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- CORE BENEFITS -->\n  <section class=\"siv-three\">\n    <div>\n      <p class=\"siv-kicker\">01</p>\n      <h3>Supports Balance</h3>\n      <p>Promotes a harmonious skin environment for improved texture and tone.</p>\n    </div>\n    <div>\n      <p class=\"siv-kicker\">02</p>\n      <h3>Delivers Vibrance</h3>\n      <p>Enhances your skin's natural radiance by supporting a healthy microbiome.</p>\n    </div>\n    <div>\n      <p class=\"siv-kicker\">03</p>\n      <h3>Builds Resilience</h3>\n      <p>Strengthens your skin's defenses against environmental stressors and aging.</p>\n    </div>\n  </section>\n\n  <!-- SIZE + HOW TO -->\n  <section class=\"siv-supply\">\n    <div class=\"siv-supply-image\">\n      <img src=\"https://sivcare.com/cdn/shop/files/SIV_duo_splash-low_3d63c9e7-58c2-4f16-8d1b-7e96c1b1922b.jpg?v=1762927376\" alt=\"SIV Biome Balancing Serum 15 mL and 30 mL\">\n    </div>\n    <div class=\"siv-supply-copy\">\n      <p class=\"siv-kicker\">SIV Biome Balancing Serum</p>\n      <h2>Your Daily Biome Step.</h2>\n      <div class=\"siv-size-line\">\n        <strong>15mL | 30 Day Supply</strong>\n        Perfect for first-time users.\n      </div>\n      <div class=\"siv-size-line\">\n        <strong>30mL | 60 Day Supply</strong>\n        Offering better value.\n      </div>\n      <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7\">Before use, shake vigorously. Apply 1–3 drops once daily. Pat into dry or damp skin. Apply after cleansing or toning.</p>\n    </div>\n  </section>\n\n  <!-- SCIENCE -->\n  <section class=\"siv-science\">\n    <article class=\"siv-science-card\">\n      <div class=\"siv-science-icon\">\n        <img src=\"https://sivcare.com/cdn/shop/files/topical-spore-treatment.png?v=1739417794\" alt=\"\">\n      </div>\n      <h3>Topical Spore Serum</h3>\n      <p>Bacillus spores support a healthy skin foundation and visibly improve skin complexion.</p>\n    </article>\n    <article class=\"siv-science-card\">\n      <div class=\"siv-science-icon\">\n        <img src=\"https://sivcare.com/cdn/shop/files/skin-identical.png?v=1739417794\" alt=\"\">\n      </div>\n      <h3>Skin Identical</h3>\n      <p>Lightweight, stabilizing formula containing physiologically identical ingredients that your skin recognizes.</p>\n    </article>\n    <article class=\"siv-science-card\">\n      <div class=\"siv-science-icon\">\n        <img src=\"https://sivcare.com/cdn/shop/files/face-base.png?v=1739417794\" alt=\"\">\n      </div>\n      <h3>Your Face Is Your Base</h3>\n      <p>Before use, shake vigorously. Apply 1–3 drops once daily and pat into dry or damp skin after cleansing or toning.</p>\n    </article>\n  </section>\n\n  <!-- INGREDIENTS -->\n  <section class=\"siv-section\">\n    <div class=\"siv-wrap\">\n      <div class=\"siv-ingredient-heading\">\n        <div>\n          <p class=\"siv-kicker\">The Formula</p>\n          <h2>Four Intentional Ingredients.</h2>\n        </div>\n        <p>Lightweight, stabilizing and built around skin-recognizable components, paired with SIV's proprietary Bacillus spore blend.</p>\n      </div>\n\n      <div class=\"siv-ingredients\">\n        <article class=\"siv-ingredient\">\n          <img src=\"https://sivcare.com/cdn/shop/files/AdobeStock_982436196.jpg?v=1762137745\" alt=\"Squalane ingredient texture\">\n          <div class=\"siv-ingredient-copy\">\n            <h3>Squalane</h3>\n            <p>Biomimetic oil derived from non-GMO sugarcane that mimics squalene and is beneficial in promoting skin hydration.</p>\n          </div>\n        </article>\n\n        <article class=\"siv-ingredient\">\n          <img src=\"https://sivcare.com/cdn/shop/files/AdobeStock_1461017641.jpg?v=1762137769\" alt=\"Caprylic Capric Triglyceride ingredient texture\">\n          <div class=\"siv-ingredient-copy\">\n            <h3>Caprylic/Capric Triglyceride</h3>\n            <p>A mixture of caprylic and capric fatty acids derived from palm oil; helps replenish the skin's surface and resist moisture loss.</p>\n          </div>\n        </article>\n\n        <article class=\"siv-ingredient\">\n          <img src=\"https://sivcare.com/cdn/shop/files/AdobeStock_1179927923.jpg?v=1762137721\" alt=\"Glyceryl Caprylate ingredient texture\">\n          <div class=\"siv-ingredient-copy\">\n            <h3>Glyceryl Caprylate</h3>\n            <p>A natural, plant-based emollient derived from glycerin and plant fatty acids that helps restore oils and regulate skin moisture.</p>\n          </div>\n        </article>\n\n        <article class=\"siv-ingredient\">\n          <img src=\"https://sivcare.com/cdn/shop/files/AdobeStock_1477484315.jpg?v=1762137800\" alt=\"Bacillus spore ingredient\">\n          <div class=\"siv-ingredient-copy\">\n            <h3>Bacillus</h3>\n            <p>A proprietary blend of Bacillus spores designed to support a healthy skin foundation, positively influence the unique skin biome and establish balance.</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section class=\"siv-final\">\n    <p class=\"siv-kicker\">The Biology of Resilience</p>\n    <h2>Give Your Skin Its Biome Step.</h2>\n    <p>Choose your size above and add the original SIV Biome Balancing Serum directly to your Shopify cart.</p>\n    <button type=\"button\" id=\"sivBackToBuy\">Shop the Serum</button>\n  </section>\n\n  <script>\n    (function(){\n      const root = document.getElementById('siv-serum-lp');\n      if(!root) return;\n\n      const VARIANTS = {\n        \"50674962366779\": { label: \"15mL - 30 Day\", fallbackPrice: \"$79.00\" },\n        \"50674962399547\": { label: \"30mL - 60 Day\", fallbackPrice: \"\" }\n      };\n\n      let selectedVariant = \"50674962366779\";\n      const priceEl = root.querySelector('#sivPrice');\n      const qtyInput = root.querySelector('#sivQty');\n      const statusEl = root.querySelector('#sivCartStatus');\n      const atc = root.querySelector('#sivAddToCart');\n\n      // Gallery\n      root.querySelectorAll('.siv-thumb').forEach(btn => {\n        btn.addEventListener('click', () => {\n          root.querySelector('#sivMainImage').src = btn.dataset.image;\n          root.querySelectorAll('.siv-thumb').forEach(x => x.classList.remove('is-active'));\n          btn.classList.add('is-active');\n        });\n      });\n\n      // Quantity\n      root.querySelector('#sivQtyMinus').addEventListener('click', () => {\n        qtyInput.value = Math.max(1, parseInt(qtyInput.value || '1',10) - 1);\n      });\n      root.querySelector('#sivQtyPlus').addEventListener('click', () => {\n        qtyInput.value = Math.max(1, parseInt(qtyInput.value || '1',10) + 1);\n      });\n      qtyInput.addEventListener('change', () => {\n        qtyInput.value = Math.max(1, parseInt(qtyInput.value || '1',10));\n      });\n\n      function money(cents){\n        try{\n          return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(cents/100);\n        }catch(e){\n          return '$' + (cents/100).toFixed(2);\n        }\n      }\n\n      // Pull live prices from the ORIGINAL Shopify product when available.\n      async function loadLiveProductData(){\n        try{\n          const res = await fetch('/products/siv-biome-balancing-serum.js', {credentials:'same-origin'});\n          if(!res.ok) throw new Error('Product data unavailable');\n          const product = await res.json();\n          product.variants.forEach(v => {\n            const id = String(v.id);\n            if(VARIANTS[id]) VARIANTS[id].price = money(v.price);\n          });\n          updatePrice();\n        }catch(e){\n          updatePrice();\n        }\n      }\n\n      function updatePrice(){\n        const v = VARIANTS[selectedVariant] || {};\n        if(v.price){\n          priceEl.textContent = v.price;\n        }else if(v.fallbackPrice){\n          priceEl.textContent = v.fallbackPrice;\n        }else{\n          priceEl.textContent = 'Price shown at checkout';\n        }\n      }\n\n      // Variant selector\n      root.querySelectorAll('.siv-size').forEach(btn => {\n        btn.addEventListener('click', () => {\n          selectedVariant = String(btn.dataset.variant);\n          root.querySelectorAll('.siv-size').forEach(x => x.classList.remove('is-active'));\n          btn.classList.add('is-active');\n          updatePrice();\n          statusEl.textContent = '';\n        });\n      });\n\n      // Add ORIGINAL variant to Shopify cart\n      atc.addEventListener('click', async () => {\n        const quantity = Math.max(1, parseInt(qtyInput.value || '1',10));\n        statusEl.textContent = '';\n        atc.disabled = true;\n        const originalText = atc.textContent;\n        atc.textContent = 'Adding…';\n\n        try{\n          const res = await fetch('/cart/add.js', {\n            method:'POST',\n            headers:{'Content-Type':'application/json','Accept':'application/json'},\n            credentials:'same-origin',\n            body:JSON.stringify({\n              items:[{id:Number(selectedVariant),quantity:quantity}]\n            })\n          });\n\n          if(!res.ok){\n            let message = 'Unable to add this item to cart.';\n            try{\n              const err = await res.json();\n              message = err.description || err.message || message;\n            }catch(e){}\n            throw new Error(message);\n          }\n\n          await res.json();\n          statusEl.textContent = 'Added to cart.';\n          atc.textContent = 'Added ✓';\n\n          // Refresh common Shopify cart UI if the theme listens for these events.\n          document.dispatchEvent(new CustomEvent('cart:refresh', {bubbles:true}));\n          document.dispatchEvent(new CustomEvent('cart:updated', {bubbles:true}));\n\n          // Redirect to the native cart after a short success state.\n          setTimeout(() => { window.location.href = '/cart'; }, 500);\n        }catch(err){\n          statusEl.textContent = err.message || 'Unable to add to cart.';\n          atc.textContent = originalText;\n          atc.disabled = false;\n          return;\n        }\n      });\n\n      root.querySelector('#sivBackToBuy').addEventListener('click', () => {\n        root.querySelector('.siv-product').scrollIntoView({behavior:'smooth',block:'start'});\n      });\n\n      loadLiveProductData();\n    })();\n  </script>\n</div>",
