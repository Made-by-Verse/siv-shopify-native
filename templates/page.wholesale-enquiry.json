          "disabled": true,
          "settings": {
            "custom_html": "<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;display=swap\" rel=\"stylesheet\">\n<style>\n  .siv-wholesale-outer{background:#EFEFE9;padding:40px 24px;box-sizing:border-box;width:100%;}\n  .siv-wholesale{background:#0E0E0E;border-radius:20px;padding:56px 5%;box-sizing:border-box;max-width:1240px;margin:0 auto;}\n  .siv-wholesale .head-wrap{text-align:center;max-width:640px;margin:0 auto;}\n  .siv-wholesale .eyebrow{margin:0 0 14px;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#FFF;}\n  .siv-wholesale h2{margin:0 0 16px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:46px;line-height:.95;letter-spacing:.02em;color:#FFF;}\n  .siv-wholesale .lede{margin:0 0 8px;font-size:16px;line-height:1.6;color:#FFF;}\n  .siv-wholesale .note{margin:0;font-size:14px;color:#FFF;}\n  .siv-wholesale .region-label{text-align:center;margin:36px 0 18px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#FFF;font-weight:600;}\n  .siv-wholesale .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1100px;margin:0 auto;}\n  .siv-wholesale .card{background:#2A2A28;border-radius:10px;border:1px solid #3A3A37;border-top:4px solid #FFFFFF;padding:24px 22px;}\n  .siv-wholesale .card p.r-name{margin:0 0 8px;font-size:17px;font-weight:600;color:#FFF;}\n  .siv-wholesale .card p.r-desc{margin:0 0 14px;font-size:14px;line-height:1.5;color:#C9C4BC;}\n  .siv-wholesale .card a{font-size:14px;font-weight:600;text-decoration:underline;text-underline-offset:3px;word-break:break-word;color:#FFFFFF;}\n  .siv-wholesale .closer{text-align:center;margin:30px 0 0;font-size:15px;color:#FFF;}\n  @media(max-width:560px){\n    .siv-wholesale-outer{padding:20px 12px;}\n    .siv-wholesale{padding:30px 18px;border-radius:16px;}\n    .siv-wholesale h2{font-size:32px;margin:0 0 10px;}\n    .siv-wholesale .eyebrow{margin:0 0 8px;}\n    .siv-wholesale .lede{font-size:14px;line-height:1.45;margin:0 0 6px;}\n    .siv-wholesale .note{font-size:13px;}\n    .siv-wholesale .region-label{font-size:12px;margin:20px 0 12px;}\n    .siv-wholesale .grid{grid-template-columns:1fr;gap:10px;}\n    .siv-wholesale .card{padding:14px 16px;border-top-width:3px;}\n    .siv-wholesale .card p.r-name{font-size:15px;margin:0 0 4px;}\n    .siv-wholesale .card p.r-desc{font-size:13px;line-height:1.35;margin:0 0 8px;}\n    .siv-wholesale .card a{font-size:13px;}\n    .siv-wholesale .closer{font-size:14px;margin:18px 0 0;}\n  }\n</style>\n<div class=\"siv-wholesale-outer\">\n  <div class=\"siv-wholesale\">\n    <div class=\"head-wrap\">\n      <p class=\"eyebrow\">Wholesale</p>\n      <h2>Become a SIV stockist</h2>\n      <p class=\"lede\">Fill out the form below to verify your credentials and unlock exclusive wholesale pricing and partner benefits.</p>\n      <p class=\"note\">Please note: we do not offer product samples.</p>\n    </div>\n    <p class=\"region-label\">Before you apply, check your region</p>\n    <div class=\"grid\">\n      <div class=\"card\">\n        <p class=\"r-name\">New Zealand</p>\n        <p class=\"r-desc\">Open an account through our local distributor.</p>\n        <a href=\"mailto:support@fxmed.co.nz\">support@fxmed.co.nz</a>\n      </div>\n      <div class=\"card\">\n        <p class=\"r-name\">Europe</p>\n        <p class=\"r-desc\">Open an account on our European site.</p>\n        <a href=\"https://www.siveurope.com\">www.siveurope.com</a>\n      </div>\n      <div class=\"card\">\n        <p class=\"r-name\">Australia</p>\n        <p class=\"r-desc\">Open an account through our local distributor.</p>\n        <a href=\"mailto:support@therahealth.com.au\">support@therahealth.com.au</a>\n      </div>\n    </div>\n    <p class=\"closer\">Everywhere else? Continue with the form below.</p>\n  </div>\n</div>",
            "desktop_width_percent": 100
