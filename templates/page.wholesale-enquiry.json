          "name": "Custom liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\nSIV WHOLESALE APPLICATION INTRO\nCustom Liquid — responsive, collapsible regions,\nand direct scroll to the application form.\n\nVerified SIV distributor contacts:\nAustralia: support@therahealth.com.au\nNew Zealand: support@fxmed.co.nz\nEurope: https://www.siveurope.com\n{%- endcomment -%}\n\n<section id=\"siv-wholesale\" aria-labelledby=\"siv-wholesale-title\">\n<style>\n#siv-wholesale {\n  --siv-black: #101010;\n  --siv-card: #252525;\n  --siv-border: #484848;\n  --siv-muted: #bdbdbd;\n  --siv-white: #ffffff;\n  font-family: inherit;\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 24px 20px;\n  box-sizing: border-box;\n}\n\n#siv-wholesale *,\n#siv-wholesale *::before,\n#siv-wholesale *::after {\n  box-sizing: border-box;\n}\n\n#siv-wholesale .siv-panel {\n  background: var(--siv-black);\n  color: var(--siv-white);\n  border-radius: 24px;\n  padding: 46px 38px 36px;\n  text-align: center;\n}\n\n#siv-wholesale .siv-eyebrow {\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: .22em;\n  text-transform: uppercase;\n  color: var(--siv-muted);\n  margin: 0 0 14px;\n}\n\n#siv-wholesale .siv-title {\n  font-family: inherit;\n  font-size: clamp(29px, 4vw, 44px);\n  font-weight: 700;\n  line-height: 1.1;\n  letter-spacing: -.025em;\n  text-transform: uppercase;\n  color: white;\n  margin: 0 0 18px;\n}\n\n#siv-wholesale .siv-intro {\n  max-width: 620px;\n  margin: 0 auto 12px;\n  color: #d0d0d0;\n  font-size: 16px;\n  line-height: 1.6;\n}\n\n#siv-wholesale .siv-note {\n  font-size: 13px;\n  color: #999;\n  margin: 0;\n}\n\n/* PRIMARY APPLICATION CTA */\n\n#siv-wholesale .siv-primary {\n  margin: 28px auto 0;\n  max-width: 410px;\n}\n\n#siv-wholesale .siv-apply {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 12px;\n  width: 100%;\n  min-height: 54px;\n  padding: 14px 20px;\n  border: 1px solid white;\n  border-radius: 8px;\n  background: white;\n  color: #111;\n  text-decoration: none;\n  font-family: inherit;\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: .025em;\n  line-height: 1.3;\n  cursor: pointer;\n  transition: background .2s, transform .2s;\n}\n\n#siv-wholesale .siv-apply:hover {\n  background: #e9e9e9;\n  transform: translateY(-2px);\n}\n\n#siv-wholesale .siv-apply svg {\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n}\n\n#siv-wholesale .siv-apply-sub {\n  font-size: 12px;\n  color: #999;\n  margin: 10px 0 0;\n}\n\n/* REGION DIVIDER */\n\n#siv-wholesale .siv-divider {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin: 36px 0 24px;\n}\n\n#siv-wholesale .siv-divider::before,\n#siv-wholesale .siv-divider::after {\n  content: \"\";\n  flex: 1;\n  height: 1px;\n  background: #363636;\n}\n\n#siv-wholesale .siv-divider span {\n  font-size: 11px;\n  color: #999;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n/* REGION INFORMATION */\n\n#siv-wholesale .siv-region-head {\n  margin: 0 auto 20px;\n  max-width: 560px;\n}\n\n#siv-wholesale .siv-region-title {\n  font-size: 17px;\n  font-weight: 600;\n  letter-spacing: .015em;\n  color: white;\n  margin: 0 0 8px;\n}\n\n#siv-wholesale .siv-region-desc {\n  font-size: 13px;\n  line-height: 1.6;\n  color: #aaa;\n  margin: 0;\n}\n\n#siv-wholesale .siv-regions {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 12px;\n  text-align: left;\n}\n\n#siv-wholesale .siv-region {\n  min-width: 0;\n  border: 1px solid var(--siv-border);\n  background: var(--siv-card);\n  border-radius: 10px;\n  overflow: hidden;\n  transition: border-color .2s;\n}\n\n#siv-wholesale .siv-region[open],\n#siv-wholesale .siv-region:hover {\n  border-color: #a0a0a0;\n}\n\n#siv-wholesale .siv-region summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 17px 18px;\n  min-height: 58px;\n  cursor: pointer;\n  list-style: none;\n  color: white;\n  font-size: 15px;\n  font-weight: 600;\n}\n\n#siv-wholesale .siv-region summary::-webkit-details-marker {\n  display: none;\n}\n\n#siv-wholesale .siv-region summary::marker {\n  content: \"\";\n}\n\n#siv-wholesale .siv-chevron {\n  width: 25px;\n  height: 25px;\n  border: 1px solid #555;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  transition: transform .2s;\n}\n\n#siv-wholesale .siv-chevron svg {\n  width: 13px;\n  height: 13px;\n}\n\n#siv-wholesale .siv-region[open] .siv-chevron {\n  transform: rotate(180deg);\n}\n\n#siv-wholesale .siv-region-body {\n  padding: 0 18px 20px;\n  color: #bdbdbd;\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n#siv-wholesale .siv-region-body p {\n  margin: 0 0 14px;\n}\n\n#siv-wholesale .siv-region-link {\n  display: inline-block;\n  color: white;\n  font-size: 13px;\n  font-weight: 600;\n  line-height: 1.5;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n  overflow-wrap: anywhere;\n}\n\n#siv-wholesale .siv-region-link:hover {\n  color: #ccc;\n}\n\n#siv-wholesale .siv-bottom {\n  margin: 26px 0 0;\n  color: #aaa;\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n#siv-wholesale .siv-bottom a {\n  color: white;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n\n#siv-wholesale a:focus-visible,\n#siv-wholesale summary:focus-visible {\n  outline: 2px solid white;\n  outline-offset: 3px;\n}\n\n/* MOBILE */\n\n@media (max-width: 749px) {\n  #siv-wholesale {\n    padding: 12px 14px 16px;\n  }\n\n  #siv-wholesale .siv-panel {\n    padding: 32px 20px 26px;\n    border-radius: 18px;\n  }\n\n  #siv-wholesale .siv-eyebrow {\n    font-size: 11px;\n    margin-bottom: 10px;\n  }\n\n  #siv-wholesale .siv-title {\n    font-size: clamp(25px, 7vw, 33px);\n    margin-bottom: 14px;\n  }\n\n  #siv-wholesale .siv-intro {\n    font-size: 14px;\n    line-height: 1.55;\n  }\n\n  #siv-wholesale .siv-note {\n    font-size: 12px;\n  }\n\n  #siv-wholesale .siv-primary {\n    margin-top: 22px;\n  }\n\n  #siv-wholesale .siv-apply {\n    min-height: 52px;\n    font-size: 13px;\n    padding: 12px;\n  }\n\n  #siv-wholesale .siv-divider {\n    margin: 30px 0 22px;\n    gap: 10px;\n  }\n\n  #siv-wholesale .siv-divider span {\n    font-size: 10px;\n    letter-spacing: .1em;\n  }\n\n  #siv-wholesale .siv-region-title {\n    font-size: 15px;\n  }\n\n  #siv-wholesale .siv-region-desc {\n    font-size: 12px;\n  }\n\n  #siv-wholesale .siv-regions {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 8px;\n  }\n\n  #siv-wholesale .siv-region summary {\n    min-height: 51px;\n    padding: 12px 15px;\n    font-size: 14px;\n  }\n\n  #siv-wholesale .siv-region-body {\n    padding: 0 15px 16px;\n  }\n\n  #siv-wholesale .siv-bottom {\n    margin-top: 20px;\n    font-size: 12px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  #siv-wholesale *,\n  #siv-wholesale *::before,\n  #siv-wholesale *::after {\n    transition: none !important;\n  }\n}\n</style>\n\n<div class=\"siv-panel\">\n\n  <header>\n    <p class=\"siv-eyebrow\">SIV Professional Wholesale</p>\n\n    <h2 class=\"siv-title\" id=\"siv-wholesale-title\">\n      Become a SIV Stockist\n    </h2>\n\n    <p class=\"siv-intro\">\n      Join our network of skincare professionals.\n      Verify your credentials to access exclusive\n      wholesale pricing and partner benefits.\n    </p>\n\n    <p class=\"siv-note\">\n      Please note: We do not offer product samples.\n    </p>\n  </header>\n\n  <div class=\"siv-primary\">\n    <a href=\"#siv-application-form\"\n       class=\"siv-apply\"\n       id=\"siv-apply-button\">\n      CONTINUE TO WHOLESALE APPLICATION\n      <svg viewBox=\"0 0 24 24\"\n           fill=\"none\"\n           stroke=\"currentColor\"\n           stroke-width=\"1.8\"\n           stroke-linecap=\"round\"\n           stroke-linejoin=\"round\"\n           aria-hidden=\"true\">\n        <path d=\"M12 5v14M5 12l7 7 7-7\"/>\n      </svg>\n    </a>\n\n    <p class=\"siv-apply-sub\">\n      For applicants outside the distributor regions below.\n    </p>\n  </div>\n\n  <div class=\"siv-divider\">\n    <span>International Distribution</span>\n  </div>\n\n  <div class=\"siv-region-head\">\n    <h3 class=\"siv-region-title\">\n      Applying from another region?\n    </h3>\n    <p class=\"siv-region-desc\">\n      Professionals in the following regions\n      should contact their designated SIV\n      distribution partner.\n    </p>\n  </div>\n\n  <div class=\"siv-regions\">\n\n    <!-- NEW ZEALAND -->\n    <details class=\"siv-region\" name=\"siv-region\">\n      <summary>\n        <span>New Zealand</span>\n        <span class=\"siv-chevron\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\"\n               fill=\"none\"\n               stroke=\"currentColor\"\n               stroke-width=\"1.8\"\n               stroke-linecap=\"round\"\n               stroke-linejoin=\"round\">\n            <path d=\"m6 9 6 6 6-6\"/>\n          </svg>\n        </span>\n      </summary>\n      <div class=\"siv-region-body\">\n        <p>\n          Open your wholesale account through\n          our New Zealand distribution partner.\n        </p>\n        <a class=\"siv-region-link\"\n           href=\"mailto:support@fxmed.co.nz\">\n          support@fxmed.co.nz\n        </a>\n      </div>\n    </details>\n\n    <!-- EUROPE -->\n    <details class=\"siv-region\" name=\"siv-region\">\n      <summary>\n        <span>Europe</span>\n        <span class=\"siv-chevron\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\"\n               fill=\"none\"\n               stroke=\"currentColor\"\n               stroke-width=\"1.8\"\n               stroke-linecap=\"round\"\n               stroke-linejoin=\"round\">\n            <path d=\"m6 9 6 6 6-6\"/>\n          </svg>\n        </span>\n      </summary>\n      <div class=\"siv-region-body\">\n        <p>\n          Open your account through\n          SIV's European website.\n        </p>\n        <a class=\"siv-region-link\"\n           href=\"https://www.siveurope.com\"\n           target=\"_blank\"\n           rel=\"noopener noreferrer\">\n          www.siveurope.com ↗\n        </a>\n      </div>\n    </details>\n\n    <!-- AUSTRALIA -->\n    <details class=\"siv-region\" name=\"siv-region\">\n      <summary>\n        <span>Australia</span>\n        <span class=\"siv-chevron\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\"\n               fill=\"none\"\n               stroke=\"currentColor\"\n               stroke-width=\"1.8\"\n               stroke-linecap=\"round\"\n               stroke-linejoin=\"round\">\n            <path d=\"m6 9 6 6 6-6\"/>\n          </svg>\n        </span>\n      </summary>\n      <div class=\"siv-region-body\">\n        <p>\n          Open your wholesale account through\n          our Australian distribution partner.\n        </p>\n        <a class=\"siv-region-link\"\n           href=\"mailto:support@therahealth.com.au\">\n          support@therahealth.com.au\n        </a>\n      </div>\n    </details>\n\n  </div>\n\n  <p class=\"siv-bottom\">\n    Not in one of these regions?\n    <a href=\"#siv-application-form\"\n       class=\"siv-scroll-link\">\n      Complete the application below ↓\n    </a>\n  </p>\n\n</div>\n\n<script>\n(function() {\n  var root = document.getElementById('siv-wholesale');\n  if (!root) return;\n\n  function findApplication() {\n    var section = root.closest('.shopify-section') || root;\n    var next = section.nextElementSibling;\n\n    while (next) {\n      if (\n        next.querySelector(\n          'form, iframe, input, textarea, select'\n        )\n      ) {\n        return next;\n      }\n      next = next.nextElementSibling;\n    }\n\n    return null;\n  }\n\n  function scrollToApplication(event) {\n    var target = findApplication();\n\n    if (!target) {\n      return;\n    }\n\n    event.preventDefault();\n\n    var header = document.querySelector(\n      '.shopify-section-header-sticky, sticky-header, #shopify-section-header'\n    );\n\n    var offset = 20;\n\n    if (header) {\n      var rect = header.getBoundingClientRect();\n      var style = window.getComputedStyle(header);\n\n      if (\n        style.position === 'sticky' ||\n        style.position === 'fixed' ||\n        rect.top <= 0\n      ) {\n        offset += rect.height;\n      }\n    }\n\n    var top = target.getBoundingClientRect().top +\n              window.pageYOffset - offset;\n\n    var reduceMotion = window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n    window.scrollTo({\n      top: Math.max(0, top),\n      behavior: reduceMotion ? 'auto' : 'smooth'\n    });\n  }\n\n  root.querySelectorAll(\n    '.siv-apply, .siv-scroll-link'\n  ).forEach(function(link) {\n    link.addEventListener('click', scrollToApplication);\n  });\n\n  root.querySelectorAll('.siv-region').forEach(\n    function(item) {\n      item.addEventListener('toggle', function() {\n        if (!item.open) return;\n\n        root.querySelectorAll('.siv-region').forEach(\n          function(other) {\n            if (other !== item) other.open = false;\n          }\n        );\n      });\n    }\n  );\n})();\n</script>\n</section>",
