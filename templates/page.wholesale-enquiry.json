          "name": "Custom liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\nSIV WHOLESALE — COMPLETE CUSTOM LIQUID\nPage: /pages/wholesale-enquiry\n\n- Compact black SIV design\n- High-contrast white text\n- Prominent international distributor accordion\n- Australia, New Zealand, Europe contacts\n- Scroll to application form below\n- Page-specific newsletter hiding\n- Preserve bottom footer\n{%- endcomment -%}\n\n{%- if request.page_type == 'page' and page.handle == 'wholesale-enquiry' -%}\n\n{%- unless request.design_mode -%}\n<style>\n/* Hide newsletter blocks in Dawn-style footer */\nfooter.footer .footer-block--newsletter,\nfooter.footer .footer__content-top {\n  display: none !important;\n}\n\n/* Hide standalone footer-group newsletter sections.\n   Preserve the actual footer section. */\n.shopify-section-group-footer-group:not(:has(footer.footer)) {\n  display: none !important;\n}\n\n/* Keep footer copyright and policy links */\nfooter.footer {\n  padding-top: 0 !important;\n  margin-top: 0 !important;\n}\n\nfooter.footer .footer__content-bottom {\n  border-top: 0 !important;\n  padding-top: 20px !important;\n}\n</style>\n{%- endunless -%}\n\n<section\n  id=\"siv-wholesale\"\n  aria-labelledby=\"siv-wholesale-title\"\n>\n\n<style>\n/* ===============================\n   SIV WHOLESALE BASE\n================================ */\n\n#siv-wholesale {\n  --siv-black: #101010;\n  --siv-card: #252525;\n  --siv-white: #ffffff;\n  --siv-border: #ffffff;\n\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 8px 16px 14px;\n  font-family: inherit;\n  box-sizing: border-box;\n}\n\n#siv-wholesale *,\n#siv-wholesale *::before,\n#siv-wholesale *::after {\n  box-sizing: border-box;\n}\n\n#siv-wholesale .siv-panel {\n  background: var(--siv-black);\n  color: #ffffff !important;\n  border-radius: 20px;\n  padding: 30px 28px 26px;\n  text-align: center;\n}\n\n/* Force white text on dark surfaces */\n\n#siv-wholesale .siv-panel h2,\n#siv-wholesale .siv-panel h3,\n#siv-wholesale .siv-panel p,\n#siv-wholesale .siv-eyebrow,\n#siv-wholesale .siv-intro,\n#siv-wholesale .siv-note,\n#siv-wholesale .siv-intl-title,\n#siv-wholesale .siv-intl-sub,\n#siv-wholesale .siv-directory-note,\n#siv-wholesale .siv-region-name,\n#siv-wholesale .siv-region-text,\n#siv-wholesale .siv-region-link {\n  color: #ffffff !important;\n  opacity: 1 !important;\n}\n\n/* ===============================\n   HEADING\n================================ */\n\n#siv-wholesale .siv-eyebrow {\n  margin: 0 0 8px;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: .2em;\n  text-transform: uppercase;\n}\n\n#siv-wholesale .siv-title {\n  margin: 0 0 12px;\n  font-family: inherit;\n  font-size: clamp(27px, 4vw, 40px);\n  font-weight: 700;\n  line-height: 1.12;\n  letter-spacing: -.025em;\n  text-transform: uppercase;\n}\n\n#siv-wholesale .siv-intro {\n  max-width: 590px;\n  margin: 0 auto 8px;\n  font-size: 15px;\n  font-weight: 400;\n  line-height: 1.5;\n}\n\n#siv-wholesale .siv-note {\n  margin: 0;\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n/* ===============================\n   APPLICATION BUTTON\n================================ */\n\n#siv-wholesale .siv-apply {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n\n  width: 100%;\n  max-width: 430px;\n  min-height: 50px;\n\n  margin: 22px auto 0;\n  padding: 12px 16px;\n\n  background: #ffffff !important;\n  border: 1px solid #ffffff;\n  border-radius: 8px;\n\n  color: #111111 !important;\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 700;\n  line-height: 1.3;\n  letter-spacing: .025em;\n  text-decoration: none !important;\n\n  cursor: pointer;\n  transition:\n    background .2s ease,\n    transform .2s ease;\n}\n\n#siv-wholesale .siv-apply:visited {\n  color: #111111 !important;\n}\n\n#siv-wholesale .siv-apply:hover {\n  background: #e9e9e9 !important;\n  transform: translateY(-2px);\n}\n\n#siv-wholesale .siv-apply svg {\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  color: #111111 !important;\n}\n\n/* ===============================\n   INTERNATIONAL ACCORDION\n================================ */\n\n#siv-wholesale .siv-international {\n  max-width: 590px;\n  margin: 24px auto 0;\n\n  background: #252525 !important;\n  border: 2px solid #ffffff !important;\n  border-radius: 12px;\n\n  text-align: left;\n  overflow: hidden;\n\n  box-shadow: 0 0 0 1px rgba(255,255,255,.08);\n\n  transition:\n    background .2s ease,\n    box-shadow .2s ease;\n}\n\n#siv-wholesale .siv-international:hover {\n  background: #303030 !important;\n  box-shadow: 0 0 0 3px rgba(255,255,255,.12);\n}\n\n#siv-wholesale .siv-international > summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n\n  min-height: 78px;\n  padding: 18px 20px;\n\n  color: #ffffff !important;\n  cursor: pointer;\n  list-style: none;\n}\n\n#siv-wholesale summary::-webkit-details-marker {\n  display: none;\n}\n\n#siv-wholesale summary::marker {\n  content: \"\";\n}\n\n#siv-wholesale .siv-intl-title {\n  display: block;\n  font-size: 17px;\n  font-weight: 700;\n  line-height: 1.35;\n  letter-spacing: -.01em;\n}\n\n#siv-wholesale .siv-intl-sub {\n  display: block;\n  margin-top: 6px;\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 1.4;\n}\n\n/* White circular toggle */\n\n#siv-wholesale .siv-chevron {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 36px;\n  height: 36px;\n  flex-shrink: 0;\n\n  background: #ffffff;\n  border: 1px solid #ffffff;\n  border-radius: 50%;\n\n  color: #111111 !important;\n\n  transition: transform .2s ease;\n}\n\n#siv-wholesale .siv-chevron svg {\n  width: 18px;\n  height: 18px;\n  color: #111111 !important;\n}\n\n#siv-wholesale .siv-international[open] .siv-chevron {\n  transform: rotate(180deg);\n}\n\n/* ===============================\n   DISTRIBUTOR CONTENT\n================================ */\n\n#siv-wholesale .siv-directory {\n  padding: 0 20px 16px;\n  background: #252525;\n}\n\n#siv-wholesale .siv-directory-note {\n  margin: 0;\n  padding: 14px 0;\n\n  border-top: 1px solid #555555;\n\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n#siv-wholesale .siv-region {\n  padding: 14px 0;\n  border-top: 1px solid #555555;\n}\n\n#siv-wholesale .siv-region-name {\n  display: block;\n  margin: 0 0 5px;\n\n  font-size: 15px;\n  font-weight: 700;\n  line-height: 1.3;\n}\n\n#siv-wholesale .siv-region-text {\n  margin: 0 0 7px;\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n#siv-wholesale .siv-region-link {\n  display: inline-block;\n  font-size: 13px;\n  font-weight: 600;\n  line-height: 1.5;\n\n  text-decoration: underline;\n  text-decoration-color: #ffffff;\n  text-underline-offset: 4px;\n\n  overflow-wrap: anywhere;\n}\n\n#siv-wholesale .siv-region-link:hover {\n  text-decoration-thickness: 2px;\n}\n\n/* Accessibility */\n\n#siv-wholesale a:focus-visible,\n#siv-wholesale summary:focus-visible {\n  outline: 2px solid #ffffff;\n  outline-offset: 4px;\n}\n\n/* ===============================\n   MOBILE\n================================ */\n\n@media (max-width: 749px) {\n\n  #siv-wholesale {\n    padding: 5px 12px 10px;\n  }\n\n  #siv-wholesale .siv-panel {\n    padding: 22px 16px 20px;\n    border-radius: 16px;\n  }\n\n  #siv-wholesale .siv-eyebrow {\n    font-size: 10px;\n    margin-bottom: 8px;\n  }\n\n  #siv-wholesale .siv-title {\n    font-size: clamp(25px, 7vw, 31px);\n    margin-bottom: 10px;\n  }\n\n  #siv-wholesale .siv-intro {\n    font-size: 13px;\n    line-height: 1.45;\n    margin-bottom: 7px;\n  }\n\n  #siv-wholesale .siv-note {\n    font-size: 11px;\n  }\n\n  #siv-wholesale .siv-apply {\n    margin-top: 17px;\n    min-height: 46px;\n    padding: 11px 10px;\n    font-size: 12px;\n  }\n\n  #siv-wholesale .siv-international {\n    margin-top: 18px;\n    border-radius: 10px;\n  }\n\n  #siv-wholesale .siv-international > summary {\n    min-height: 72px;\n    padding: 15px 14px;\n  }\n\n  #siv-wholesale .siv-intl-title {\n    font-size: 15px;\n    line-height: 1.35;\n  }\n\n  #siv-wholesale .siv-intl-sub {\n    font-size: 12px;\n    margin-top: 5px;\n  }\n\n  #siv-wholesale .siv-chevron {\n    width: 32px;\n    height: 32px;\n  }\n\n  #siv-wholesale .siv-directory {\n    padding: 0 14px 12px;\n  }\n}\n\n/* Reduced motion */\n\n@media (prefers-reduced-motion: reduce) {\n  #siv-wholesale .siv-apply,\n  #siv-wholesale .siv-international,\n  #siv-wholesale .siv-chevron {\n    transition: none;\n  }\n\n  #siv-wholesale .siv-apply:hover {\n    transform: none;\n  }\n}\n</style>\n\n<div class=\"siv-panel\">\n\n  <header>\n    <p class=\"siv-eyebrow\">\n      SIV Professional Wholesale\n    </p>\n\n    <h2 class=\"siv-title\" id=\"siv-wholesale-title\">\n      Become a SIV Stockist\n    </h2>\n\n    <p class=\"siv-intro\">\n      Join our network of skincare professionals.\n      Verify your credentials to access exclusive\n      wholesale pricing and partner benefits.\n    </p>\n\n    <p class=\"siv-note\">\n      Please note: We do not offer product samples.\n    </p>\n  </header>\n\n  <!-- PRIMARY APPLICATION BUTTON -->\n\n  <a\n    href=\"#siv-application-form\"\n    class=\"siv-apply\"\n  >\n    CONTINUE TO WHOLESALE APPLICATION\n\n    <svg\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"1.8\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M12 5v14M5 12l7 7 7-7\"/>\n    </svg>\n  </a>\n\n  <!-- INTERNATIONAL DISTRIBUTORS -->\n\n  <details class=\"siv-international\">\n\n    <summary>\n      <span>\n        <span class=\"siv-intl-title\">\n          Outside the U.S.? Find Your Distributor\n        </span>\n\n        <span class=\"siv-intl-sub\">\n          Australia, New Zealand &amp; Europe\n        </span>\n      </span>\n\n      <span class=\"siv-chevron\" aria-hidden=\"true\">\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.8\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n        >\n          <path d=\"m6 9 6 6 6-6\"/>\n        </svg>\n      </span>\n    </summary>\n\n    <div class=\"siv-directory\">\n\n      <p class=\"siv-directory-note\">\n        Practitioners in these regions should\n        open their wholesale accounts through\n        their designated SIV distribution partner.\n      </p>\n\n      <!-- AUSTRALIA -->\n\n      <div class=\"siv-region\">\n        <span class=\"siv-region-name\">\n          Australia\n        </span>\n\n        <p class=\"siv-region-text\">\n          Contact our Australian distribution partner.\n        </p>\n\n        <a\n          class=\"siv-region-link\"\n          href=\"mailto:support@therahealth.com.au\"\n        >\n          support@therahealth.com.au\n        </a>\n      </div>\n\n      <!-- NEW ZEALAND -->\n\n      <div class=\"siv-region\">\n        <span class=\"siv-region-name\">\n          New Zealand\n        </span>\n\n        <p class=\"siv-region-text\">\n          Contact our New Zealand distribution partner.\n        </p>\n\n        <a\n          class=\"siv-region-link\"\n          href=\"mailto:support@fxmed.co.nz\"\n        >\n          support@fxmed.co.nz\n        </a>\n      </div>\n\n      <!-- EUROPE -->\n\n      <div class=\"siv-region\">\n        <span class=\"siv-region-name\">\n          Europe\n        </span>\n\n        <p class=\"siv-region-text\">\n          Open your account through SIV Europe.\n        </p>\n\n        <a\n          class=\"siv-region-link\"\n          href=\"https://www.siveurope.com\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n        >\n          www.siveurope.com ↗\n        </a>\n      </div>\n\n    </div>\n  </details>\n\n</div>\n\n<script>\n(function() {\n  var root = document.getElementById('siv-wholesale');\n  if (!root) return;\n\n  var button = root.querySelector('.siv-apply');\n  if (!button) return;\n\n  button.addEventListener('click', function(event) {\n    var section = root.closest('.shopify-section') || root;\n    var target = section.nextElementSibling;\n\n    // Find next visible section containing the application.\n    while (target) {\n      if (\n        target.offsetHeight > 0 &&\n        target.querySelector(\n          'form, iframe, input, textarea, select'\n        )\n      ) {\n        break;\n      }\n      target = target.nextElementSibling;\n    }\n\n    // Fallback to the next visible section.\n    if (!target) {\n      target = section.nextElementSibling;\n      while (target && target.offsetHeight === 0) {\n        target = target.nextElementSibling;\n      }\n    }\n\n    if (!target) return;\n\n    event.preventDefault();\n\n    var offset = 16;\n    var header = document.querySelector(\n      'sticky-header, .shopify-section-header-sticky, #shopify-section-header'\n    );\n\n    if (header) {\n      var style = window.getComputedStyle(header);\n\n      if (\n        style.position === 'sticky' ||\n        style.position === 'fixed'\n      ) {\n        offset += header.getBoundingClientRect().height;\n      }\n    }\n\n    var top =\n      target.getBoundingClientRect().top +\n      window.pageYOffset -\n      offset;\n\n    var smooth = !window.matchMedia(\n      '(prefers-reduced-motion: reduce)'\n    ).matches;\n\n    window.scrollTo({\n      top: Math.max(0, top),\n      behavior: smooth ? 'smooth' : 'auto'\n    });\n  });\n})();\n</script>\n\n</section>\n\n{%- endif -%}",
