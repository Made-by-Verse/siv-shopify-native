ht:1.1}\n  .siv-code{color:#a9b88a;font-weight:700;letter-spacing:.04em}\n  .siv-pill{display:inline-block;background:#a9b88a;color:#121212;font-weight:700;font-size:15px;letter-spacing:.14em;text-transform:uppercase;padding:12px 26px;border-radius:999px}\n  .siv-card a.siv-link{color:#efefe9;text-decoration:underline}\n  .siv-fine{font-size:13px;line-height:1.6;color:#d7d2cb;border-top:1px solid #3a3a3a;padding-top:20px;margin:28px 0 0}\n  /* Hides the footer Newsletter section on this page only */\n  .shopify-section-group-footer-group[id*=\"newsletter\"],\n  .shopify-section[id*=\"__newsletter\"]{display:none !important}\n</style>\n\n<div class=\"siv-replay\">\n  <section class=\"siv-hero\">\n    <p class=\"siv-eyebrow\">Webinar Replay</p>\n    <h1 class=\"siv-h1\">The Missing<br><span>Step.</span>\n</h1>\n    <div class=\"siv-video\">\n<div style=\"padding:56.25% 0 0 0;position:relative;\"><iframe src=\"https://player.vimeo.com/video/1229756355?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479\" frameborder=\"0\" allow=\"autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;\" title=\"20260923_THEMISSINGSTEP\"></iframe></div>\n<script src=\"https://player.vimeo.com/api/player.js\"></script>\n</div>\n  </section>\n\n  <section class=\"siv-body\">\n    <div class=\"siv-card\" style=\"margin:0\">\n      <h3>A Thank You For Joining Us</h3>\n      <p class=\"siv-p\">Enjoy 15% off your professional order with code <span class=\"siv-code\">BIOMEWEBINAR15</span> through Wednesday, September 30 at 11:59 PM Eastern.</p>\n      <p style=\"margin:28px 0\"><a class=\"siv-btn\" href=\"/account/login\">Shop Now →</a></p>\n      <p style=\"margin:0 0 28px\"><span class=\"siv-pill\">Code: BIOMEWEBINAR15</span></p>\n      <p class=\"siv-p\" style=\"margin:0\">Don’t have a professional account yet? <a class=\"siv-link\" href=\"#A