{%- comment -%}
  Page-level layout, spacing and motion for the Biome Balancing Serum product page only.
  Matches the system used on Biome Balance Within (bbw-page-polish).
  Rendered from layout/theme.liquid when template.suffix contains 'serum-new'.
{%- endcomment -%}
<script>
  (function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('bbw-motion');
    function init() {
      var main = document.getElementById('MainContent');
      if (!main) return;
      var staggerSel = [
        '[id$="__key_points"] .wrapper > div:nth-child(2)',
        '[id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2)',
        '[id*="__section_featured_product"] .wrapper ul',
        '[data-sivp-stagger]'
      ].join(',');
      main.querySelectorAll(staggerSel).forEach(function (c) {
        c.setAttribute('data-bbw-stagger', '');
        Array.prototype.forEach.call(c.children, function (el, i) {
          el.setAttribute('data-bbw-reveal', '');
          el.style.setProperty('--bbw-delay', Math.min(i, 6) * 80 + 'ms');
        });
      });
      main.querySelectorAll('.shopify-section.section:not([id$="__main"]) .wrapper > *, .shopify-section.siv-pdp-sec .wrapper > *').forEach(function (el) {
        if (el.hasAttribute('data-bbw-stagger')) return;
        if (el.querySelector('[data-bbw-stagger]')) {
          Array.prototype.forEach.call(el.children, function (ch) {
            if (!ch.hasAttribute('data-bbw-stagger')) ch.setAttribute('data-bbw-reveal', '');
          });
          return;
        }
        el.setAttribute('data-bbw-reveal', '');
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      main.querySelectorAll('[data-bbw-reveal]').forEach(function (el) { io.observe(el); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
<style>
  .page-serum {
    --bbw-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --bbw-space: clamp(3.5rem, 6vw, 5.5rem);
  }

  /* One spacing rhythm */
  .page-serum #MainContent .section { margin-top: 0; margin-bottom: 0; padding-top: var(--bbw-space); padding-bottom: 0; }
  .page-serum #MainContent [id$="__main"].section { padding-top: 2.5rem; }
  .page-serum #MainContent [id*="__section_featured_product"].section { padding-bottom: var(--bbw-space); }
  .page-serum #MainContent [id*="__section_ingredients"].section { padding-bottom: var(--bbw-space); }

  /* Quiet the theme's fade-in / fade-out so content stays put once read */
  .page-serum #MainContent [x-intersect\:enter] { opacity: 1 !important; --tw-translate-y: 0 !important; transform: none !important; transition: none !important; }
  .page-serum #MainContent [x-intersect\.half\:enter] > span { opacity: 1 !important; transform: none !important; transition: none !important; }
  .page-serum #MainContent h2, .page-serum #MainContent .h2, .page-serum #MainContent .h3 { transition: none; }

  /* Single, quick reveal */
  .bbw-motion .page-serum [data-bbw-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s var(--bbw-ease) var(--bbw-delay, 0ms), transform 0.6s var(--bbw-ease) var(--bbw-delay, 0ms);
  }
  .bbw-motion .page-serum [data-bbw-reveal].is-in { opacity: 1; transform: none; }

  /* Press feedback */
  .page-serum #MainContent .btn, .page-serum #MainContent button[type="submit"] { transition-property: color, background-color, border-color, transform; transition-duration: 0.12s; transition-timing-function: var(--bbw-ease); }
  .page-serum #MainContent .btn:active, .page-serum #MainContent button[type="submit"]:active { transform: scale(0.97); }

  /* Top of page: larger gallery, buy column aligned edge to edge */
  .page-serum [id$="__main"] .product-details > .max-w-xl { max-width: none; margin: 0; }
  .page-serum [id$="__main"] .ws-pricing--solo { max-width: none; }
  .page-serum [id$="__main"] .product-details .h2 { font-size: clamp(2.25rem, 3.4vw, 3.25rem); }
  @media (min-width: 1024px) {
    .page-serum [id$="__main"] > .wrapper { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 4rem; align-items: start; }
  }

  /* Balance in a bottle: heading with its paragraph, even cards */
  .page-serum [id$="__key_points"] .wrapper > div:first-child { display: block; margin-bottom: 1rem; }
  .page-serum [id$="__key_points"] .wrapper > div:first-child > .prose { max-width: 40rem; margin-top: 1.25rem; }
  .page-serum [id$="__key_points"] .wrapper > div:first-child > .prose:empty { display: none; }
  .page-serum [id$="__key_points"] .wrapper > div:nth-child(2) { gap: 2rem 1.5rem; }

  /* The essential serum: heading left-aligned like every other section, calmer image */
  .page-serum [id*="__section_featured_product"] .wrapper > h2 { text-align: left; margin-left: 0; margin-bottom: 2.5rem; max-width: none; }
  .page-serum [id*="__section_featured_product"] .wrapper > .grid { gap: 2.5rem 4rem; }
  @media (min-width: 1024px) {
    .page-serum [id*="__section_featured_product"] .wrapper > .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr); }
  }
  .page-serum [id*="__section_featured_product"] .aspect-portrait { max-height: 36rem; }
  .page-serum [id*="__section_featured_product"] ul h3 { font-size: 1rem; }

  /* Results: heading and slider share one row */
  .page-serum [id$="__testimonies"] .wrapper { align-items: start; }

  /* Ingredients: cards, 4 across on wide screens, 2 on tablet, 1 on phone */
  .page-serum [id*="__section_ingredients"] .wrapper > .grid { grid-template-columns: 1fr; gap: 2.5rem; margin-bottom: 0; }
  .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:first-child .sticky { position: static; }
  .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2) { grid-column: auto; gap: 3rem 2rem; }
  .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2) > div { grid-template-columns: 1fr; gap: 1.25rem; align-content: start; }
  .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2) > div > div:first-child { aspect-ratio: 3 / 2; }
  .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2) > div > div:first-child img:last-child { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-serum [id*="__section_ingredients"] .prose, .page-serum [id*="__section_ingredients"] .prose li { max-width: 34rem; text-wrap: pretty; }
  @media (min-width: 768px) {
    .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .page-serum [id*="__section_ingredients"] .wrapper > .grid > div:nth-child(2) { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3rem 1.5rem; }
    .page-serum [id*="__section_ingredients"] h3 { font-size: 1rem; line-height: 1.35; }
    .page-serum [id*="__section_ingredients"] .prose { font-size: 0.9375rem; }
  }

  @media (max-width: 767px) {
    .page-serum { --bbw-space: 3.5rem; }
  }
</style>
