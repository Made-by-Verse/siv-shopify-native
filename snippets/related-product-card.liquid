{% comment %}
  Renders a "Pairs well with" related-product card, styled after the home hero
  featured product. The "Shop Now" button opens a quick-buy drawer (which handles
  variant selection, add-to-cart and "View Product").

  Accepts:
  - product: {Object} related product to show.
  - drawer_id: {String} id of the quick-buy drawer to open. The card dispatches
      the `open-{{ drawer_id }}` event, so it must match the rendered drawer.

  Usage:
  {% render 'related-product-card', product: related_product, drawer_id: 'related-product-drawer' %}
{% endcomment %}

{%- if product != blank and compact -%}
  {%- assign open_event = 'open-' | append: drawer_id -%}
  <style>
    .siv-pairs { display: flex; align-items: center; gap: 1.5rem; width: 100%; margin-top: 1.5rem; padding: 1.1rem 1.75rem; background: #e6e3dd; border: 0; border-radius: 0.5rem; text-align: left; cursor: pointer; color: inherit; transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.12s cubic-bezier(0.16, 1, 0.3, 1); }
    .siv-pairs:hover { background: #dedad3; }
    .siv-pairs:active { transform: scale(0.98); }
    .siv-pairs__img { width: 3.25rem; height: 4rem; flex: none; display: flex; align-items: center; justify-content: center; }
    .siv-pairs__img img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
    .siv-pairs__text { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
    .siv-pairs__eyebrow { font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(var(--color-contrast), 0.6); }
    .siv-pairs__name { font-size: 1.125rem; font-weight: 600; }
    .siv-pairs__arrow { font-size: 1.25rem; opacity: 0.5; }
    @media (prefers-reduced-motion: reduce) { .siv-pairs { transition: none; } }
  </style>
  <button type="button" x-data class="siv-pairs related-product-card" @click="$dispatch('{{ open_event }}');" aria-label="Pairs well with {{ product.title | escape }}">
    <span class="siv-pairs__img">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 160 | image_tag: alt: '' }}{%- endif -%}</span>
    <span class="siv-pairs__text">
      <span class="siv-pairs__eyebrow">Pairs well with</span>
      <span class="siv-pairs__name">{{ product.title }}</span>
    </span>
    <span class="siv-pairs__arrow" aria-hidden="true">&rarr;</span>
  </button>
{%- elsif product != blank -%}
  {%- assign open_event = 'open-' | append: drawer_id -%}
  <div class="related-product-card mt-10">
    <h2 class="font-body text-sm uppercase font-bold tracking-wide mb-3">Pairs well with</h2>
    <div class="flex rounded-xl overflow-hidden w-full text-contrast border border-black/10">
      <div class="w-1/4 flex justify-center items-center bg-primary">
        {% render 'responsive-image',
          image: product.featured_image,
          wrapper_class: 'relative aspect-portrait w-full h-full overflow-hidden',
          image_class: 'absolute inset-0 object-cover w-full h-full'
        %}
      </div>
      <div class="w-3/4 p-6 flex flex-col gap-2 bg-white">
        <h3 class="font-heading text-2xl">{{ product.title }}</h3>
        {% render 'price', product: product, show_compare_at_price: true %}
        <div class="mt-auto pt-4">
          {% render 'button', button_text: 'Shop Now', event_trigger: open_event, button_class: 'btn--black' %}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
